{
	"extends": "$app/tsconfig",
	"exclude": [
		"./node_modules/**",
		"./src/service-worker.js",
		"./src/service-worker/**/*.js",
		"./src/service-worker.ts",
		"./src/service-worker/**/*.ts",
		"./src/service-worker.d.ts",
		"./src/service-worker/**/*.d.ts",
		"./src/lib/paraglide/**"
	],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"]
}
