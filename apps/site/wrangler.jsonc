{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Must not exceed what the installed workerd supports, which lags the calendar.
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat"],

	// Written by the SvelteKit Cloudflare adapter: the prerendered pages and client bundle.
	// Unrelated to data/bucket/objects, which the CDN worker serves from R2.
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},

	// The site's API, which runs in this Worker; see spec/architecture/services.md, "The site's API
	// runs in the site's Worker". Records only, and read-only: the published root and one per
	// asset, never the bucket the CDN serves. See spec/architecture/data.md, "One bucket holds
	// records and the other holds bytes".
	"r2_buckets": [{ "binding": "STORE", "bucket_name": "metadata" }],
	// Named `api` from when the API was a Worker of its own; a database is not renamed for the
	// Worker that reads it. See spec/engagement.md, "One D1 database owns API state".
	"d1_databases": [
		{
			"binding": "DATABASE",
			"database_name": "api",
			"database_id": "959379fe-f528-4304-9f40-3e1c957208fe",
			"migrations_dir": "api/drizzle",
		},
	],
	// `quota`'s inside door, which counts apps/site/api/src/contract/limits.ts and the read
	// counter's own minute. See spec/architecture/quota.md.
	"services": [{ "binding": "QUOTA", "service": "quota", "entrypoint": "Internal" }],

	// `vite dev` on 26511 is the development server, and is what platform/libs/sdk records. This port
	// is for `wrangler dev`, which exercises the built worker instead.
	"dev": {
		"port": 26514,
		"inspector_port": 26515,
	},

	"observability": { "logs": { "enabled": true, "invocation_logs": true } },
	"placement": { "mode": "smart" },

	// Custom domains only; see apps/cdn for the reasoning.
	"workers_dev": false,
	"preview_urls": false,
}
