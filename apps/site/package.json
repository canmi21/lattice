{
	"name": "@canmi/site",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm run database:migrate:local && vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "pnpm run database:migrate:remote && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"database:migrate:local": "wrangler d1 migrations apply api --local",
		"database:migrate:remote": "wrangler d1 migrations apply api --remote"
	},
