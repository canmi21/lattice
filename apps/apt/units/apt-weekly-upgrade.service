# Installed on the machine by hand, not by this repository -- see spec/architecture/apt.md,
# "The work stays on the machine, in two units". apt starts this unit over systemd's D-Bus API;
# when it runs is cron's, per spec/architecture/cron.md.
[Unit]
Description=apt-get full-upgrade, asked for by apt over D-Bus

[Service]
Type=oneshot
ExecStart=/usr/bin/apt-get -q -o DPkg::Lock::Timeout=600 update
ExecStart=/usr/bin/apt-get -q -y -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
ExecStart=/usr/bin/apt-get -q -y -o DPkg::Lock::Timeout=600 autoremove --purge
ExecStart=/usr/bin/apt-get -q clean
# A newer kernel than the one running waits for a reboot; noted in the journal, not acted on.
ExecStartPost=/bin/sh -c 'test -f /var/run/reboot-required && cat /var/run/reboot-required || true'
