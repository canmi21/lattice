{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cdn",
	"main": "src/index.ts",
	// Must not exceed what the installed workerd supports, which lags the calendar. Setting
	// this to "today" fails to start with a date mismatch rather than anything descriptive.
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat"],

	// Content-addressed bytes and nothing else. The records live in a bucket this worker has no
	// credential for, which is what stops a key the publisher rewrites in place from being served
	// with a year of `immutable`. See spec/architecture/data.md, "One bucket holds records and the
	// other holds bytes".
	"r2_buckets": [
		{
			"binding": "STORE",
			"bucket_name": "public",
		},
	],

	// The port also appears in libs/urls as the development CDN URL. wrangler cannot read a
	// TypeScript library, so the number is written twice on purpose. This is the base
	// workspace's pair; `mise run dev-cdn` passes an overlay's shifted pair as flags,
	// computed by libs/urls from the same number. See spec/toolchain.md.
	"dev": {
		// Every interface, so a phone on the same network can reach this worker. The port is
		// still the mutex a second copy collides on; see spec/toolchain.md.
		"ip": "*",
		"port": 26516,
		"inspector_port": 26517,
	},

	// Development reads the objects tree itself, because the local tree is the source of truth
	// and dev should read the source rather than a copy. It lives under `env.dev` so that a plain
	// `wrangler deploy` never sees it -- otherwise deploying would upload every photo in
	// data/bucket/objects alongside the worker, which is precisely what R2 exists to avoid.
	//
	// `run_worker_first` matters more than it looks. Without it wrangler answers asset requests
	// before the worker runs, so routing and cache headers are simply skipped and dev serves
	// `max-age=0` where production serves a year. Measured: that is exactly what happened.
	"env": {
		"dev": {
			// data/draft, not data/bucket/objects: it holds the same corpus plus the drafts, and
			// symlinks to the published assets the publish step writes for it. One directory covering
			// both trees is what `wrangler dev` allows, since it binds exactly one. A reader never
			// sees this tree -- rclone is pointed inside data/bucket and cannot reach it.
			"assets": {
				"directory": "../../data/draft/objects",
				"binding": "ASSETS",
				"run_worker_first": true,
			},
		},
	},

	"observability": { "logs": { "enabled": true } },
	"placement": { "mode": "smart" },
	// Custom domains only. Every generated hostname is another route to the same worker that
	// nothing in front of the custom domain guards, and one nobody is watching.
	"workers_dev": false,
	"preview_urls": false,
}
