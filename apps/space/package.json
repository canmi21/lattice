{
	"name": "@canmi/space",
	"private": true,
	"description": "canmi.app: the design system, drawn from the code itself.",
	"keywords": [
		"cloudflare-workers",
		"design-system",
		"sveltekit"
	],
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "vite build && wrangler deploy"
	},
	"devDependencies": {
		"@canmi/design": "^2026.1011.0",
		"@canmi/fonts": "workspace:*",
		"@canmi/kit": "^2026.1010.0",
		"@canmi/web": "^2026.1009.0",
		"@cloudflare/workers-types": "^5.20261004.1",
		"@monoflake/sdk": "^2026.1007.1",
		"@stylexjs/stylex": "^0.19.1",
		"@stylexjs/unplugin": "^0.19.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	}
}
