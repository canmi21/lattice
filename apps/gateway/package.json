{
	"name": "@canmi/gateway",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --env dev",
		"deploy": "wrangler deploy --env=\"\"",
		"build": "wrangler deploy --dry-run --outdir=dist --env=\"\"",
		"bundle": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/node.mjs"
	},
	"dependencies": {
		"@canmi/artifacts": "workspace:*",
		"@canmi/cache": "workspace:*",
		"@canmi/limits": "workspace:*",
		"@canmi/response": "workspace:*",
		"@canmi/robots": "workspace:*",
		"@canmi/security": "workspace:*",
		"@canmi/symlink": "workspace:*",
		"@hono/node-server": "^2.1.3",
		"@monoflake/sdk": "workspace:*",
		"hono": "^4.13.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261004.1",
		"esbuild": "^0.28.2",
		"smol-toml": "^1.9.0",
		"valibot": "^1.5.0",
		"wrangler": "^4.147.0"
	}
}
