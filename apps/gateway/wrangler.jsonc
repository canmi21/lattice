{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gateway",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-29",

	// The public API host, declared here so every deploy asserts it: attached in the dashboard, it
	// was gone after a deploy and nothing said so. See spec/toolchain.md.
	// The service layer's hosts this Worker answers; each is a profile in src/profile.ts. See
	// spec/architecture/gateway.md.
	"routes": [
		{ "pattern": "api.ffoni.com", "custom_domain": true },
		{ "pattern": "cdn.ffoni.com", "custom_domain": true },
		{ "pattern": "ill.li", "custom_domain": true },
		{ "pattern": "api.monoflake.com", "custom_domain": true },
		{ "pattern": "cdn.monoflake.com", "custom_domain": true },
		{ "pattern": "api.monoflake.net", "custom_domain": true },
		{ "pattern": "cdn.monoflake.net", "custom_domain": true },
		{ "pattern": "symlink.si", "custom_domain": true },
		// Every deployment's own host, one label under the apex, by the zone's wildcard record.
		{ "pattern": "*.ixc.one/*", "zone_name": "ixc.one" },
	],

	// Each scope placed on Workers is a binding here, named by `bindingOf` in src/table.ts, and
	// src/index.test.ts holds this list to the generated table. See spec/architecture/services.md,
	// "One API host, scoped by path".
	"services": [
		{ "binding": "AKA", "service": "aka" },
		{ "binding": "CDN", "service": "cdn" },
		{ "binding": "HOOK", "service": "hook" },
		{ "binding": "SITE", "service": "site" },
	],

	// One counter per address and route, for the limits every service.toml declares: a Durable
	// Object, since Cloudflare's rate limit binding counts per location. SQLite-backed, the one kind
	// the free plan has, though it writes nothing. See spec/architecture/services.md, "A limit is
	// declared once and kept in three places".
	"durable_objects": { "bindings": [{ "name": "limits", "class_name": "counter" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["counter"] }],

	// The Caddy of the machine at home, the same VPC service `hook` notifies through.
	"vpc_services": [
		{ "binding": "HOME", "service_id": "01a0e5b1-1072-72d3-81cf-5b1c69ad7a6e", "remote": true },
	],

	// Also in libs/urls as the API's development port, which callers ask; wrangler cannot read that
	// library. Every interface, so a phone on the same network reaches it. See spec/toolchain.md.
	"dev": {
		"ip": "*",
		"port": 26512,
		"inspector_port": 26513,
	},

	// Bindings do not inherit into a named environment. In development a Worker served by wrangler
	// is bound by the name its session registers under, `-dev` suffixed for a named environment; the
	// site runs under Vite instead, so its binding is the word `development` and the gateway asks
	// its development address. No node: the machine at home is production's.
	"env": {
		"dev": {
			"services": [{ "binding": "HOOK", "service": "hook" }],
			"vars": { "SITE": "development", "CDN": "development", "AKA": "development" },
			"durable_objects": { "bindings": [{ "name": "limits", "class_name": "counter" }] },
		},
	},

	"observability": { "logs": { "enabled": true } },
	"workers_dev": false,
	"preview_urls": false,
}
