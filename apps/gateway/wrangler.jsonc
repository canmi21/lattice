{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-29",

	// The public API host, api.ffoni.com, attached in the dashboard like every other custom domain.
	// Each scope placed on Workers is a binding here, named by `bindingOf` in src/table.ts, and
	// src/index.test.ts holds this list to the generated table. See spec/architecture/services.md,
	// "One API host, scoped by path".
	"services": [
		{ "binding": "HOOK", "service": "hook" },
		{ "binding": "SITE", "service": "site" },
	],

	// The Caddy of the machine at home, the same VPC service `hook` notifies through.
	"vpc_services": [
		{ "binding": "HOME", "service_id": "01a0e5b1-1072-72d3-81cf-5b1c69ad7a6e", "remote": true },
	],

	// Also in libs/urls as the API's development port, which callers ask; wrangler cannot read that
	// library. Every interface, so a phone on the same network reaches it. See spec/toolchain.md.
	"dev": {
		"ip": "*",
		"port": 26512,
		"inspector_port": 26513,
	},

	// Bindings do not inherit into a named environment. In development a Worker served by wrangler
	// is bound by the name its session registers under, `-dev` suffixed for a named environment; the
	// site runs under Vite instead, so its binding is the word `development` and the gateway asks
	// its development address. No node: the machine at home is production's.
	"env": {
		"dev": {
			"services": [{ "binding": "HOOK", "service": "hook" }],
			"vars": { "SITE": "development" },
		},
	},

	"observability": { "logs": { "enabled": true } },
	"workers_dev": false,
	"preview_urls": false,
}
