<?xml version="1.0"?>
<!-- Baked into the image; only users.xml is written at start, onto tmpfs, since the root
     filesystem is read-only. See spec/architecture/databases.md, "The drivers". -->
<clickhouse>
	<logger>
		<level>information</level>
		<console>true</console>
	</logger>

	<listen_host>0.0.0.0</listen_host>
	<http_port>8123</http_port>
	<mlock_executable>false</mlock_executable>

	<path>/var/lib/clickhouse/</path>
	<tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
	<user_files_path>/tmp/clickhouse-runtime/user_files/</user_files_path>
	<access_control_path>/tmp/clickhouse-runtime/access/</access_control_path>
	<format_schema_path>/tmp/clickhouse-runtime/format_schemas/</format_schema_path>

	<!-- A small sidecar's ceiling, kept under the container's memory_mb; see service.toml. No
	     system log tables are declared here, so ClickHouse keeps none. -->
	<mark_cache_size>134217728</mark_cache_size>
	<uncompressed_cache_size>0</uncompressed_cache_size>
	<mmap_cache_size>0</mmap_cache_size>
	<max_server_memory_usage>1207959552</max_server_memory_usage>

	<default_profile>default</default_profile>
	<default_database>default</default_database>
	<timezone>UTC</timezone>

	<!-- Generated by entrypoint.sh from CLICKHOUSE_USER and CLICKHOUSE_PASSWORD at start, onto
	     tmpfs, since the credentials are only known at run time. -->
	<user_directories>
		<users_xml>
			<path>/tmp/clickhouse-runtime/users.xml</path>
		</users_xml>
	</user_directories>
</clickhouse>
