#!/usr/bin/env bash
#MISE description="The newest stable ClickHouse release tag, for the Dockerfile and its label"
# ClickHouse tags a release `vMAJOR.MINOR.PATCH.BUILD-stable` or `-lts`; the highest of either by
# version is the one built. See spec/architecture/databases.md, "The drivers".
set -euo pipefail

git ls-remote --tags --refs https://github.com/ClickHouse/ClickHouse.git \
	| awk -F/ '{print $NF}' \
	| grep -E '^v[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+-(stable|lts)$' \
	| sort -V | tail -1
