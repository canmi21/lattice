{
	// Everything that runs in a browser, or in neither runtime in particular. Type checking
	// only: libraries export .ts straight from src and consumers bundle it, so nothing emits.
	// See spec/architecture/workspace.md, "A runtime's globals decide which program checks a file".
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom"]
	},
	"include": ["libs/**/*.ts", "apps/**/*.ts", "*.ts"],
	"exclude": [
		"**/node_modules",
		"**/dist",
		"**/build",
		"data",
		// Both check themselves with svelte-check instead: SvelteKit generates the `$lib` and
		// `$app` aliases and the `*.svelte` module types elsewhere, so this file alone sees half
		// a project.
		"apps/site",
		"apps/cms",
		// Checked by tsconfig.workers.json against workerd's globals instead. Whole directories,
		// not just `src`: importing the worker is enough to pull it into this program.
		"libs/store",
		"apps/api",
		"apps/cdn",
		"apps/aka"
	]
}
