{
	// Everything that runs in a browser, or in neither runtime in particular. Type checking
	// only: libraries export .ts straight from src and consumers bundle it, so nothing emits.
	// See the workspace's spec/code.md, "A runtime's globals decide which program checks a file".
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom"]
	},
	"include": ["apps/**/*.ts", "libs/**/*.ts", "*.ts"],
	"exclude": [
		"**/node_modules",
		"**/dist",
		"**/build",
		"data",
		// Each checks itself with svelte-check instead: SvelteKit generates the `$lib` and
		// `$app` aliases and the `*.svelte` module types elsewhere, so this file alone sees half
		// a project.
		"apps/site",
		"apps/cms",
		"apps/status",
		"apps/landing"
	]
}
