#!/usr/bin/env python3
#MISE description="Build or check web-font chunks declared in data/record/fonts.json"
"""Build web-font chunks without turning retained full faces into a requirement.

The manifest makes the two independent roles of a full face visible: a disposable pipeline
input and, for the one family that needs it, a runtime dependency. A chunk is an object like
every other, named by the content id of its own bytes and filed in the shared fan-out tree.
See spec/architecture/fonts.md.
"""

from __future__ import annotations

import json
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Any

ROOT = pathlib.Path(__file__).resolve().parents[2]
MANIFEST = ROOT / "data/record/fonts.json"
PUBLIC = ROOT / "data/bucket/objects"
RECORD = ROOT / "data/build/fonts.json"
RECORD_VERSION = 1
RUNNER = pathlib.Path(__file__).with_name("font-split.mjs")
HASHER = pathlib.Path(__file__).with_name("content-id.mjs")
# Every `url()` a stylesheet carries, and the object address the pipeline rewrites each into.
FONT_URL = re.compile(r"url\((['\"]?)([^)'\"]+\.woff2)\1\)")
OBJECT_URL = re.compile(r"__CDN_URL__/object/([0-9a-f]{32})\.woff2")
UNICODE_RANGE = re.compile(r"unicode-range:\s*([^;]+);")
SPLITTER_COMMENT = re.compile(r"/\* Generated By cn-font-split@.*?\*/\s*", re.DOTALL)

# These are the stable writing-system groupings used by Google Fonts CSS. They deliberately
# live in the pipeline rather than each family record: a subset name has one meaning, while
# the manifest only chooses which named groups a face publishes.
SUBSET_RANGES = {
	"latin": (
		"U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,"
		"U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,"
		"U+FEFF,U+FFFD"
	),
	"latin-ext": (
		"U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,"
		"U+2C60-2C7F,U+A720-A7FF"
	),
	"vietnamese": (
		"U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,"
		"U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB"
	),
	"greek": "U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF",
	"greek-ext": "U+1F00-1FFF",
	"cyrillic": "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116",
	"cyrillic-ext": (
		"U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F"
	),
}
GENERIC_FAMILIES = {"serif", "sans-serif", "monospace", "cursive", "fantasy", "system-ui"}


def load_manifest() -> dict[str, Any]:
	try:
		return json.loads(MANIFEST.read_text())
	except (OSError, json.JSONDecodeError) as error:
		raise ValueError(f"could not read {MANIFEST.relative_to(ROOT)}: {error}") from error


def repo_path(value: str) -> pathlib.Path:
	path = (ROOT / value).resolve()
	if ROOT not in path.parents:
		raise ValueError(f"path leaves the repository: {value}")
	return path


def content_ids(paths: list[pathlib.Path]) -> list[str]:
	"""What the bucket would name each of these files, asked of the one implementation of it.

	BLAKE3 truncated to 128 bits, which is neither in Python's standard library nor fast enough
	to write here: the whole published set is hashed on every check. See ./content-id.mjs.
	"""
	if not paths:
		return []
	answer = subprocess.run(
		["node", str(HASHER)],
		cwd=ROOT,
		input="\n".join(str(path) for path in paths),
		capture_output=True,
		text=True,
		check=True,
	)
	ids = answer.stdout.split()
	if len(ids) != len(paths):
		raise RuntimeError(f"hashed {len(paths)} files and got {len(ids)} content ids back")
	return ids


def object_path(cid: str) -> pathlib.Path:
	"""Where an object lives: its content id, fanned out. The twin of `storageKey` in libs/store."""
	return PUBLIC / cid[:2] / cid[2:4] / f"{cid}.woff2"


def object_url(cid: str) -> str:
	return f"__CDN_URL__/object/{cid}.woff2"


def bucket_path(url: str) -> pathlib.Path:
	"""The file a stylesheet's own URL names, for a chunk that is not an object yet."""
	key = url.removeprefix("__CDN_URL__").lstrip("/")
	if ".." in key:
		raise ValueError(f"stylesheet URL leaves the bucket: {url}")
	return PUBLIC / key


def publish_objects(paths: list[pathlib.Path]) -> list[str]:
	"""Put each file in the objects tree under its own content id, and answer the ids.

	A content-addressed key cannot denote different bytes, so one already there is this one:
	nothing is compared and nothing is replaced. The same rule the corpus publishes under.
	"""
	ids = content_ids(paths)
	for path, cid in zip(paths, ids):
		target = object_path(cid)
		if target.is_file():
			continue
		target.parent.mkdir(parents=True, exist_ok=True)
		shutil.copyfile(path, target)
	return ids


def stylesheet_urls(css: str) -> list[str]:
	return [url for _, url in FONT_URL.findall(css)]


def rewrite_urls(css: str, published: dict[str, str]) -> str:
	"""Point every URL this stylesheet carries at the object its bytes became.

	One already naming an object is left as it is, so a run interrupted halfway through a
	stylesheet can simply be run again.
	"""

	def replace(match: re.Match[str]) -> str:
		quote, url = match.group(1), match.group(2)
		if OBJECT_URL.fullmatch(url):
			return match.group(0)
		cid = published.get(url)
		if cid is None:
			raise RuntimeError(f"stylesheet names a chunk that was not published: {url}")
		return f"url({quote}{object_url(cid)}{quote})"

	return FONT_URL.sub(replace, css)


def stylesheet_chunks(css: str) -> list[str]:
	"""The content ids a published stylesheet names, or a failure naming what it carries instead.

	Every URL has to be an object address. A family half-way through adoption reads as published
	until something asks, and `/fonts/` is not an address this CDN can express any more.
	"""
	ids = []
	for url in stylesheet_urls(css):
		found = OBJECT_URL.fullmatch(url)
		if not found:
			raise ValueError(f"URL is not an object address: {url}")
		ids.append(found.group(1))
	return ids


def published_chunks(manifest: dict[str, Any]) -> dict[str, list[str]]:
	return {
		family["id"]: stylesheet_chunks(repo_path(family["stylesheet"]).read_text())
		for family in manifest["families"]
	}


def write_record(manifest: dict[str, Any]) -> None:
	"""Say which objects the published stylesheets name, for everything that is not a browser.

	`cms gc` sweeps the objects tree against what each record claims, and a font chunk is reached
	from no article and no root. Written here because this is what published them: a sweep reading
	the stylesheets instead would be deciding what to delete by parsing somebody else's output.
	"""
	RECORD.parent.mkdir(parents=True, exist_ok=True)
	record = {"version": RECORD_VERSION, "families": published_chunks(manifest)}
	RECORD.write_text(json.dumps(record, indent="\t", ensure_ascii=False) + "\n")


def check_record(manifest: dict[str, Any]) -> list[str]:
	"""The record against the stylesheets, because a stale one is a sweep waiting to happen.

	Missing counts as stale rather than as nothing to check: the record is what stands between
	these chunks and `cms gc`, and its absence is indistinguishable from a family with none.
	"""
	advice = "run `mise run fonts --adopt --all`"
	try:
		record = json.loads(RECORD.read_text())
	except (OSError, json.JSONDecodeError):
		return [f"no published record at {RECORD.relative_to(ROOT)}; {advice}"]
	if record.get("version") != RECORD_VERSION:
		return [f"published record is version {record.get('version')!r}; {advice}"]
	if record.get("families") != published_chunks(manifest):
		return [f"published record does not match the stylesheets; {advice}"]
	return []


def declared_chunks(family: dict[str, Any]) -> int:
	return sum(len(face.get("subsets", [])) for face in family.get("faces", []))


def validate_shared(
	family: dict[str, Any],
	families: dict[str, dict[str, Any]],
) -> list[str]:
	"""Two entries publishing one set of chunks, which used to be a shared output directory.

	Content addressing makes identical bytes identical objects on its own; what it cannot say is
	that the two are *meant* to stay identical, so re-slicing one rewrites both stylesheets.
	"""
	label = family["id"]
	name = family["chunksFrom"]
	if name not in families:
		return [f"{label}: chunksFrom names no family: {name}"]
	source = families[name]
	if source.get("chunksFrom"):
		return [f"{label}: chunksFrom names a family that shares chunks itself: {name}"]
	mine = [(face["stem"], tuple(face.get("subsets", []))) for face in family["faces"]]
	theirs = [(face["stem"], tuple(face.get("subsets", []))) for face in source["faces"]]
	if mine != theirs:
		return [f"{label}: shares chunks with {name} but declares different faces"]
	return []


def validate_family(
	family: dict[str, Any],
	families: dict[str, dict[str, Any]],
	require_published: bool = True,
) -> list[str]:
	problems: list[str] = []
	label = family.get("id", "<unnamed>")
	strategy = family.get("strategy")
	if strategy not in {"named-subsets", "frequency-chunks"}:
		problems.append(f"{label}: unknown strategy {strategy!r}")
		return problems

	chunks = family.get("chunks")
	if chunks not in {"prebuilt", "generated"}:
		problems.append(f"{label}: chunks must be prebuilt or generated")
	if family.get("generic") not in GENERIC_FAMILIES:
		problems.append(f"{label}: generic must name a CSS generic family")
	if family.get("chunksFrom"):
		problems.extend(validate_shared(family, families))

	stylesheet = repo_path(family["stylesheet"])
	if not stylesheet.is_file():
		problems.append(f"{label}: stylesheet is missing: {stylesheet.relative_to(ROOT)}")

	for face in family.get("faces", []):
		input_name = face.get("input")
		if chunks == "generated" and not input_name:
			problems.append(f"{label}: a generated face has no pipeline input")
		if input_name and not repo_path(input_name).is_file():
			problems.append(f"{label}: pipeline input is missing: {input_name}")
		local = face.get("local", [])
		if not isinstance(local, list) or any(not isinstance(name, str) for name in local):
			problems.append(f"{label}: local face sources must be a list of names")
		if strategy == "named-subsets":
			for subset in face.get("subsets", []):
				if subset not in SUBSET_RANGES:
					problems.append(f"{label}: unknown named subset {subset!r}")

	runtime = family.get("runtimeInput")
	if runtime:
		for key in ("path", "consumer"):
			value = runtime.get(key)
			if not value or not repo_path(value).is_file():
				problems.append(f"{label}: runtime {key} is missing: {value}")

	if require_published and stylesheet.is_file() and not problems:
		problems.extend(validate_published(family, families, stylesheet))

	return problems


def validate_published(
	family: dict[str, Any],
	families: dict[str, dict[str, Any]],
	stylesheet: pathlib.Path,
) -> list[str]:
	"""What the stylesheet names, against what is in the objects tree.

	The stylesheet is the record of which chunks a family has -- the only one, now that there is
	no directory of its own to list, and already the only one for the hundreds a CJK face has.
	Nothing here looks for chunks nothing names: an object no stylesheet reaches is what `cms gc`
	sweeps, not a font problem.
	"""
	label = family["id"]
	css = stylesheet.read_text()
	try:
		cids = stylesheet_chunks(css)
	except ValueError as error:
		return [f"{label}: {error}"]

	if f"font-family: '{family['family']}'" not in css:
		return [f"{label}: stylesheet does not declare this family"]

	problems = []
	missing = sorted({cid for cid in cids if not object_path(cid).is_file()})
	if missing:
		return [f"{label}: chunks are not published: {', '.join(missing)}"]
	present = sorted(set(cids))
	wrong = sorted(
		cid
		for cid, hashed in zip(present, content_ids([object_path(cid) for cid in present]))
		if cid != hashed
	)
	if wrong:
		problems.append(f"{label}: chunk names do not match their content: {', '.join(wrong)}")

	if family.get("chunksFrom") and family["chunksFrom"] in families:
		source = repo_path(families[family["chunksFrom"]]["stylesheet"])
		if source.is_file() and stylesheet_chunks(source.read_text()) != cids:
			problems.append(f"{label}: does not name the same chunks as {family['chunksFrom']}")

	if family["strategy"] == "named-subsets":
		if len(cids) != declared_chunks(family):
			problems.append(
				f"{label}: stylesheet names {len(cids)} chunks for {declared_chunks(family)} subsets"
			)
		declared = {
			"".join(SUBSET_RANGES[subset].split())
			for face in family["faces"]
			for subset in face["subsets"]
		}
		published = {"".join(value.split()) for value in UNICODE_RANGE.findall(css)}
		if published != declared:
			problems.append(f"{label}: published subsets do not match its faces")

	return problems


def check(manifest: dict[str, Any]) -> int:
	families = manifest.get("families", [])
	ids = [family.get("id") for family in families]
	problems = []
	if len(ids) != len(set(ids)):
		problems.append("font family ids are not unique")
	by_id = {family["id"]: family for family in families}
	for family in families:
		problems.extend(validate_family(family, by_id))
	# Only once every stylesheet has been read successfully: the record is derived from them, so
	# it can say nothing useful about a family whose own stylesheet is the thing that is wrong.
	if not problems:
		problems.extend(check_record(manifest))
	if problems:
		print("Font manifest problems:", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1
	probe_splitter(families)
	print(f"fonts OK: {len(families)} families")
	return 0


def codepoints(unicode_range: str) -> list[int]:
	points: list[int] = []
	for item in unicode_range.split(","):
		bounds = item.removeprefix("U+").split("-")
		start = int(bounds[0], 16)
		end = int(bounds[-1], 16)
		points.extend(range(start, end + 1))
	return points


def split(config: dict[str, Any], directory: pathlib.Path) -> None:
	config_path = directory / "config.json"
	config_path.write_text(json.dumps(config))
	subprocess.run(
		["node", str(RUNNER), str(config_path)],
		cwd=ROOT,
		check=True,
	)


def probe_splitter(families: list[dict[str, Any]]) -> None:
	generated = next(
		(
			family
			for family in families
			if family["chunks"] == "generated" and not family.get("chunksFrom")
		),
		None,
	)
	if generated is None:
		return
	with tempfile.TemporaryDirectory(prefix=".font-split-check.") as temp:
		directory = pathlib.Path(temp)
		config = {
			"input": str(repo_path(generated["faces"][0]["input"])),
			"outDir": str(directory),
			"subsets": [[0x41]],
			"subsetRemainChars": False,
			"autoSubset": False,
			"fontFeature": True,
			"renameOutputFont": "probe.[ext]",
			"testHtml": False,
			"reporter": False,
			"silent": True,
		}
		split(config, directory)
		outputs = list(directory.glob("*.woff2"))
		if len(outputs) != 1 or outputs[0].stat().st_size == 0:
			raise RuntimeError("cn-font-split smoke slice did not produce one non-empty WOFF2 file")


def generated_css(directory: pathlib.Path) -> str:
	stylesheets = list(directory.glob("*.css"))
	if len(stylesheets) != 1:
		raise RuntimeError(f"cn-font-split produced {len(stylesheets)} stylesheets, expected one")
	return stylesheets[0].read_text()


def stylesheet_header(path: pathlib.Path) -> str:
	if not path.is_file():
		return ""
	text = path.read_text()
	start = text.find("@font-face")
	header = text[:start] if start >= 0 else text.rstrip() + "\n\n"
	return SPLITTER_COMMENT.sub("", header)


def build_frequency(family: dict[str, Any], stage: pathlib.Path) -> str:
	face = family["faces"][0]
	config = {
		"input": str(repo_path(face["input"])),
		"outDir": str(stage),
		"css": {
			"fontFamily": family["family"],
			"fontWeight": face["weight"],
			"fontStyle": face["style"],
			"fontDisplay": "swap",
			"localFamily": face.get("local", [family["family"]]),
			"commentUnicodes": False,
			"compress": False,
		},
		"renameOutputFont": "[hash:32].[ext]",
		"testHtml": False,
		"reporter": False,
		"silent": True,
	}
	split(config, stage)
	css = SPLITTER_COMMENT.sub("", generated_css(stage))
	# The splitter's own names reach no further than this rewrite: every chunk is addressed by
	# the content id the bucket files it under, and the stylesheet is the only thing holding them.
	written = stylesheet_urls(css)
	sources = [stage / pathlib.PurePosixPath(url).name for url in written]
	return rewrite_urls(css, dict(zip(written, publish_objects(sources))))


def face_css(family: dict[str, Any], face: dict[str, Any], subset: str, cid: str) -> str:
	sources = [f"local('{name}')" for name in face.get("local", [])]
	sources.append(f"url('{object_url(cid)}') format('woff2')")
	src = ",\n\t\t".join(sources)
	return f"""@font-face {{
	font-family: '{family['family']}';
	font-style: {face['style']};
	font-weight: {face['weight']};
	font-display: swap;
	src:
		{src};
	unicode-range: {SUBSET_RANGES[subset]};
}}"""


def named_parts(family: dict[str, Any]) -> list[tuple[dict[str, Any], str]]:
	"""Each chunk a named-subsets family publishes, in the order its stylesheet declares them."""
	return [(face, subset) for face in family["faces"] for subset in face["subsets"]]


def build_named(family: dict[str, Any], stage: pathlib.Path) -> str:
	sliced = []
	for face, subset in named_parts(family):
		filename = f"{face['stem']}-{subset}"
		part = stage / filename
		part.mkdir()
		config = {
			"input": str(repo_path(face["input"])),
			"outDir": str(part),
			"subsets": [codepoints(SUBSET_RANGES[subset])],
			"subsetRemainChars": False,
			"autoSubset": False,
			"fontFeature": True,
			"renameOutputFont": f"{filename}.[ext]",
			"testHtml": False,
			"reporter": False,
			"silent": True,
		}
		split(config, part)
		fonts = list(part.glob("*.woff2"))
		if len(fonts) != 1:
			raise RuntimeError(f"{filename}: cn-font-split produced {len(fonts)} chunks")
		sliced.append(fonts[0])
	ids = publish_objects(sliced)
	rules = [
		face_css(family, face, subset, cid)
		for (face, subset), cid in zip(named_parts(family), ids)
	]
	return "\n\n".join(rules) + "\n"


def build_shared(family: dict[str, Any], source: dict[str, Any]) -> str:
	"""A stylesheet written from another family's published chunks, with this family's own names.

	Nothing is sliced and nothing is published: the chunks are already objects, and the only
	difference between the two stylesheets is which local faces may satisfy the choice.
	"""
	cids = stylesheet_chunks(repo_path(source["stylesheet"]).read_text())
	parts = named_parts(family)
	if len(cids) != len(parts):
		raise RuntimeError(f"{family['id']}: {source['id']} publishes {len(cids)} chunks")
	rules = [face_css(family, face, subset, cid) for (face, subset), cid in zip(parts, cids)]
	return "\n\n".join(rules) + "\n"


def write_stylesheet(family: dict[str, Any], css: str) -> None:
	"""The stylesheet is written last, for the reason the root is: it names the objects."""
	stylesheet = repo_path(family["stylesheet"])
	stylesheet.write_text(stylesheet_header(stylesheet) + css)


def adopt(family: dict[str, Any]) -> None:
	"""Publish the chunks a stylesheet already names, wherever its URLs say they are.

	How a set of bytes becomes objects without being sliced again -- which is the only way a
	family with no retained input can be published at all, and the only way any family moves
	without its chunks changing. Idempotent: a stylesheet already naming objects is verified
	and left alone.
	"""
	stylesheet = repo_path(family["stylesheet"])
	css = stylesheet.read_text()
	unpublished: dict[str, pathlib.Path] = {}
	for url in stylesheet_urls(css):
		found = OBJECT_URL.fullmatch(url)
		if found:
			if not object_path(found.group(1)).is_file():
				raise RuntimeError(f"{family['id']}: chunk is not published: {found.group(1)}")
			continue
		path = bucket_path(url)
		if not path.is_file():
			raise RuntimeError(f"{family['id']}: chunk is missing: {path.relative_to(ROOT)}")
		unpublished[url] = path
	if not unpublished:
		print(f"{family['id']}: every chunk is already an object")
		return
	ids = publish_objects(list(unpublished.values()))
	# Written whole rather than through `write_stylesheet`: adoption edits the addresses in the
	# stylesheet it was handed and leaves everything else, header included, exactly as authored.
	repo_path(family["stylesheet"]).write_text(rewrite_urls(css, dict(zip(unpublished, ids))))
	print(f"{family['id']}: adopted {len(ids)} chunks into the objects tree")


def build(family: dict[str, Any], families: dict[str, dict[str, Any]]) -> None:
	if family.get("chunksFrom"):
		write_stylesheet(family, build_shared(family, families[family["chunksFrom"]]))
		print(f"{family['id']}: rewritten from {family['chunksFrom']}'s chunks")
		return
	if family["chunks"] == "prebuilt":
		print(f"{family['id']}: published chunks are complete; no build is needed")
		return
	with tempfile.TemporaryDirectory(prefix=f".{family['id']}.") as temp:
		stage = pathlib.Path(temp)
		if family["strategy"] == "frequency-chunks":
			css = build_frequency(family, stage)
		else:
			css = build_named(family, stage)
		write_stylesheet(family, css)
	print(f"{family['id']}: published {len(stylesheet_chunks(css))} chunks")
	# A family sharing these chunks names them itself, so it is rewritten rather than left
	# pointing at the slice this one replaced.
	for other in families.values():
		if other.get("chunksFrom") == family["id"]:
			build(other, families)


def select(families: dict[str, dict[str, Any]], name: str) -> list[dict[str, Any]]:
	if name == "--all":
		# A family sharing another's chunks is rewritten after the one that publishes them.
		return sorted(families.values(), key=lambda family: bool(family.get("chunksFrom")))
	return [families[name]]


def main() -> int:
	try:
		manifest = load_manifest()
		arguments = sys.argv[1:]
		if arguments == ["--check"]:
			return check(manifest)
		families = {family["id"]: family for family in manifest["families"]}
		adopting = arguments[:1] == ["--adopt"]
		selection = arguments[1:] if adopting else arguments
		if len(selection) != 1:
			print(
				"usage: mise run fonts --check | --adopt <family>|--all | <family> | --all",
				file=sys.stderr,
			)
			return 2
		for family in select(families, selection[0]):
			published = family["chunks"] == "prebuilt" and not adopting
			problems = validate_family(family, families, require_published=published)
			if problems:
				raise ValueError("; ".join(problems))
			if adopting:
				adopt(family)
			else:
				build(family, families)
		# After the last stylesheet is written and before anything reads them, so a run that ends
		# here leaves the sweep's account of these chunks agreeing with what a browser will fetch.
		write_record(manifest)
		return check(manifest)
	except (KeyError, OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
		print(f"fonts: {error}", file=sys.stderr)
		return 1


if __name__ == "__main__":
	sys.exit(main())
