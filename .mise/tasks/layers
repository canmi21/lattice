#!/usr/bin/env python3
#MISE description="Fail on a package that depends on a layer above its own"
"""Every dependency points down: a package may use its own layer's and those below, never one
above. A package's layer is the first segment of its path, so a package not moved yet has none
and is not held. See spec/architecture/layers.md, "The directory is the layer"."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from graph import LAYERS, layer_of, node_graph, rust_graph  # noqa: E402

# Upward dependencies known and owed a fix, as (dependent, dependency) -> where it is written
# down. Each is removed with its fix, and the list is empty before the repositories split.
EXCEPTIONS = {
	("host", "monoflake"): "layers.md, coupling 2: host renders the gateway's names",
	("@monoflake/panel", "@monoflake/sdk"): "layers.md, coupling 3: the panel shows cron and the ledger",
}


def upward(directories, edges):
	"""Every (dependent, dependency) pair whose dependency sits above the dependent."""
	place = {name: layer_of(directory) for directory, name in directories.items()}
	found = []
	for dependency, dependents in edges.items():
		for dependent in dependents:
			below, above = place.get(dependent), place.get(dependency)
			if below and above and LAYERS.index(above) > LAYERS.index(below):
				found.append((dependent, dependency, below, above))
	return found


def main():
	crate_dirs, crate_edges, _ = rust_graph()
	package_dirs, package_edges = node_graph()
	found = upward(crate_dirs, crate_edges) + upward(package_dirs, package_edges)
	directories = [*crate_dirs, *package_dirs]
	placed = sum(1 for directory in directories if layer_of(directory))
	failed, excused = [], set()
	for dependent, dependency, below, above in sorted(found):
		if (dependent, dependency) in EXCEPTIONS:
			excused.add((dependent, dependency))
			print(f"warning: {dependent} ({below}) uses {dependency} ({above}), excepted")
		else:
			failed.append(dependent)
			print(f"error: {dependent} ({below}) uses {dependency} ({above}), a layer above it")
	for pair in sorted(set(EXCEPTIONS) - excused):
		print(f"warning: {pair[0]} no longer uses {pair[1]}; its exception can go")
	print(f"layers: {placed} of {len(directories)} packages placed, {len(failed)} pointing up")
	return 1 if failed else 0


if __name__ == "__main__":
	sys.exit(main())
