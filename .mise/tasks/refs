#!/usr/bin/env python3
#MISE description="Check that references resolve and that URLs live in one place"
"""Validate how this repo refers to things: to its own files, and to hosts. Four checks, all
chosen because they are objective rather than stylistic:

1. A markdown link in a doc points at a file that exists.
2. A `spec/**/*.md` cited from code exists.
3. A section name quoted beside such a citation, in code or in another doc, exists in it.
4. No URL the running system resolves is written outside `libs/urls`.

The first three break silently on rename; the last enforces spec/architecture/workspace.md,
"Every URL is declared once", which was prose-only until this existed. What is deliberately
not flagged -- prose paths, comments, `$schema`, `@context` -- is argued at each constant.

Run with --json to emit the pair graph instead of validating.
"""

from __future__ import annotations

import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
# Recursive, because a spec topic large enough to need several files gets a directory rather
# than a longer file. A non-recursive glob would silently stop checking the moment one did.
DOC_GLOBS = ("spec/**/*.md", "CLAUDE.md")
CODE_SUFFIXES = {
	".ts",
	".js",
	".mjs",
	".svelte",
	".html",
	".rs",
	".py",
	".css",
	".toml",
	".json",
	".jsonc",
	".yaml",
	".yml",
}
# Directories whose files are records or prose rather than code, plus the lockfile.
# The code_files docstring gives each exemption's reason.
SKIP_DIRS = {"data", "contents"}
SKIP_FILES = {"pnpm-lock.yaml"}

MD_LINK = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
DOC_PATH = r"[a-z0-9-]+(?:/[a-z0-9-]+)*\.md"
SPEC_REF = re.compile(rf"spec/{DOC_PATH}")
# A citation may name a section: `spec/x.md, "Name"` or `spec/x.md ("Name")`. The quote need not
# sit against it -- the gap here runs from two characters to forty-six -- but it may not cross a
# full stop or a semicolon, or a sentence quoting something else is read as this one's anchor.
ANCHOR = r'[^".;\n]{0,60}?"(?P<anchor>[^"]{6,160})"'
CODE_ANCHOR = re.compile(rf"(?P<target>spec/{DOC_PATH}){ANCHOR}")
# A doc cites by markdown link or by bare path, and either may be relative to the citing file.
DOC_ANCHOR = re.compile(rf"(?:\[[^\]]*\]\()?(?P<target>(?:\.\./)*{DOC_PATH})\)?{ANCHOR}")
# An anchor may wrap, so continuation lines fold away before matching. `///` and `//!` come
# before `//`: the shorter alternative matches first and leaves a stray slash inside the quote,
# which reads as a break in an anchor that is intact.
COMMENT_WRAP = re.compile(r"\n[ \t]*(?:\*|///|//!|//)?[ \t]*")
# Prose carries no comment markers, and a `*` opening a line is emphasis rather than one.
PROSE_WRAP = re.compile(r"\n\s*")
SPACES = re.compile(r"\s+")
NOT_WORD = re.compile(r"[^a-z0-9 ]")
# The backslash ends a match so `url=\"https://a.example\"` inside a Rust format string reads
# as the address alone, not the address plus its escape.
URL = re.compile(r"https?://[^\s\"'`)\],;\\]+")
COMMENT = re.compile(r"^\s*(//|#|\*|/\*|<!--)")
# The library itself, and the generated Rust mirror a `mise run urls` writes from it -- one
# map, two languages. rust.test.ts holds the mirror to the map, so the exemption cannot hide
# an edit made to the Rust side alone.
URL_HOMES = ("libs/urls/", "apps/cms/src/urls.rs")
# `$schema` keys have to be URLs because mise-installed tools have no node_modules to point
# at (spec/toolchain.md). JSON-LD's `@context` is a namespace identifier like an xmlns:
# changing it changes what the document means, not where anything points. `registry+https://`
# is cargo's own source-id syntax, quoted in test fixtures in cargo's spelling -- an
# identifier again, and not this software's to respell.
URL_EXEMPT = ('"$schema"', "'@context'", '"@context"', "registry+https://")
# Names RFC 2606 reserves so they can never resolve. A URL on one of these is a placeholder --
# for an API demanding an absolute URL, or a value a test needs rejected -- and never an
# endpoint. Exempting by rule rather than case by case is what keeps this from collecting
# exceptions. Case-insensitive because DNS is: a test probing host lowercasing spells a
# reserved name in mixed case on purpose.
URL_UNRESOLVABLE = re.compile(
	r"https?://(?:[^/\s]*\.)?(?:test|example|invalid|localhost)(?:[/:?#]|$)"
	r"|https?://(?:[^/\s]*\.)?example\.(?:com|net|org)(?:[/:?#]|$)",
	re.IGNORECASE,
)
# An XML namespace is an identifier that the specification explicitly does not require to be
# dereferenceable, and changing one changes the document's meaning rather than where it points.
# Treating these as endpoints would demand they be declared alongside hosts we actually call.
XML_NAMESPACE = re.compile(r"xmlns(?::[\w-]+)?\s*=|schemaLocation")
TEMPLATE_AUTHORITY = re.compile(r"https?://[{$]")


def docs() -> list[pathlib.Path]:
	found: list[pathlib.Path] = []
	for pattern in DOC_GLOBS:
		found.extend(sorted(ROOT.glob(pattern)))
	return found


def code_files() -> list[pathlib.Path]:
	"""Files whose URLs something other than a reader would resolve.

	The candidate set comes from git, because `.gitignore` is already the one home of "this is
	build output, not code"; a second list of what is code can only ever drift from the first.
	`contents/` is excluded whatever the extension -- a translation sidecar is YAML by format and
	prose by nature, and asking its links to live in libs/urls would be asking an article not to
	cite anything. `data/` holds curated records, not code, and is excluded the same way.
	"""
	listing = subprocess.run(
		["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
		capture_output=True,
		text=True,
		check=True,
	)
	return [
		path
		for name in listing.stdout.split("\0")
		if name
		for path in [ROOT / name]
		if path.name not in SKIP_FILES
		and path.suffix in CODE_SUFFIXES
		and not SKIP_DIRS & set(pathlib.PurePath(name).parts)
	]


def read(path: pathlib.Path) -> str:
	try:
		return path.read_text()
	except (OSError, UnicodeDecodeError):
		return ""


def without_code(text: str) -> str:
	"""Blank out fenced blocks and inline code, keeping line structure intact.

	A doc that documents markdown syntax writes things like `![](cid.ext)` inside backticks.
	Those are examples of a link, not links, and reading them as targets makes the spec unable
	to describe the very format this repository uses without tripping its own gate.
	"""
	text = FENCE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
	return INLINE_CODE.sub(lambda m: " " * len(m.group(0)), text)


FENCE = re.compile(r"```.*?```", re.S)
INLINE_CODE = re.compile(r"`[^`\n]+`")


def dead_doc_links() -> list[str]:
	dead = []
	for doc in docs():
		for match in MD_LINK.finditer(without_code(read(doc))):
			target = match.group(1)
			if target.startswith(("http://", "https://", "#", "mailto:")):
				continue
			if not (doc.parent / target.split("#")[0]).exists():
				dead.append(f"{doc.relative_to(ROOT)} -> {target}")
	return dead


def stray_urls() -> list[str]:
	"""URLs written outside libs/urls that something other than a reader would resolve."""
	stray = []
	for path in code_files():
		rel = str(path.relative_to(ROOT))
		if rel.startswith(URL_HOMES):
			continue
		for number, line in enumerate(read(path).splitlines(), 1):
			if COMMENT.match(line) or any(token in line for token in URL_EXEMPT):
				continue
			if XML_NAMESPACE.search(line):
				continue
			for match in URL.finditer(line):
				if URL_UNRESOLVABLE.match(match.group(0)):
					continue
				# `https://{domain}/` and `https://${host}` are scheme templates: the authority
				# arrives at runtime, so there is no address here to single-source.
				if TEMPLATE_AUTHORITY.match(match.group(0)):
					continue
				stray.append(f"{rel}:{number} {match.group(0)}")
	return stray


def pair_graph() -> dict[str, list[str]]:
	"""spec file -> the code files that cite it."""
	graph: dict[str, list[str]] = {}
	for path in code_files():
		rel = str(path.relative_to(ROOT))
		for spec in sorted(set(SPEC_REF.findall(read(path)))):
			graph.setdefault(spec, []).append(rel)
	return graph


def locate(spec: str) -> pathlib.Path | None:
	"""Where a cited spec file is, or None when nothing from here up holds it.

	Rules that follow the author rather than this project live in the workspace above, so a
	citation of `spec/code.md` resolves one directory up. Walk rather than hardcode the depth:
	the same file has to answer the same way whether this repository sits inside that workspace
	or was cloned on its own -- in which case nothing above it exists and the citation is
	genuinely dead. See the meta repository's architecture/repos.md.
	"""
	directory = ROOT
	while True:
		if (directory / spec).exists():
			return directory / spec
		if directory.parent == directory:
			return None
		directory = directory.parent


BODIES: dict[pathlib.Path, str] = {}


def flatten(text: str) -> str:
	"""Text reduced to its lowercase words, every other character becoming a space.

	Applied to the heading's file and to the anchor alike, so a heading spelling a name in
	backticks or separating a clause with an em dash still matches the citation quoting it.
	"""
	return NOT_WORD.sub(" ", SPACES.sub(" ", text).lower()).strip()


def flattened(path: pathlib.Path | None) -> str | None:
	"""One file flattened and kept, or None when it is not there."""
	if path is None or not path.is_file():
		return None
	if path not in BODIES:
		BODIES[path] = flatten(read(path))
	return BODIES[path]


def dead_anchors() -> tuple[list[str], int]:
	"""Section names quoted from code or from another doc that the named file no longer holds.

	A file existing does not mean the section named inside it still does, so a heading is part of
	the interface. Read raw rather than through `without_code`: an anchor quotes its heading
	verbatim, inline code and all. A target that is not there is somebody else's failure above.
	"""
	dead: list[str] = []
	seen = 0
	sources = [(path, CODE_ANCHOR, COMMENT_WRAP) for path in code_files()]
	sources += [(doc, DOC_ANCHOR, PROSE_WRAP) for doc in docs()]
	for path, pattern, wrap in sources:
		for match in pattern.finditer(wrap.sub(" ", read(path))):
			cited = match.group("target")
			target = locate(cited) if cited.startswith("spec/") else path.parent / cited
			body = flattened(target)
			if body is None:
				continue
			seen += 1
			if flatten(match.group("anchor")) not in body:
				dead.append(f'{path.relative_to(ROOT)} -> {cited} ("{match.group("anchor")}")')
	return dead, seen


def main() -> int:
	graph = pair_graph()

	if "--json" in sys.argv:
		print(json.dumps(graph))
		return 0

	dead, anchors = dead_anchors()

	problems = [f"dead link: {d}" for d in dead_doc_links()]
	problems += [
		f"missing spec cited by {cited}: {spec}"
		for spec, cited in sorted(graph.items())
		if not locate(spec)
		for cited in [", ".join(cited)]
	]
	problems += [f"missing section: {d}" for d in dead]
	problems += [
		f"URL outside {URL_HOMES[0]}: {u}  (declare it there, or make it a comment if it is a"
		f" citation -- see spec/architecture.md)"
		for u in stray_urls()
	]

	if problems:
		print("Reference check failed:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1

	linked = sum(len(v) for v in graph.values())
	print(
		f"references OK: {len(docs())} docs, {linked} code -> spec citations, "
		f"{anchors} quoted sections, URLs single-sourced"
	)
	return 0


if __name__ == "__main__":
	sys.exit(main())
