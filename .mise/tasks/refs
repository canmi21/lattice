#!/usr/bin/env python3
#MISE description="Check that references resolve and that URLs live in one place"
"""Validate how this repo refers to things: to its own files, and to hosts. Four checks, all
chosen because they are objective rather than stylistic:

1. A markdown link in a doc points at a file that exists.
2. A `spec/**/*.md` cited from code, or from the extensionless text beside it, exists.
3. A section name quoted beside such a citation, in code or in another doc, exists in it.
4. No URL the running system resolves is written outside `libs/urls`.

The first three break silently on rename and are shared with the workspace's own gate, which is
where they live. The fourth is this repository's and enforces spec/architecture/workspace.md,
"Every URL is declared once", prose-only until this existed. Each constant argues what it exempts.

Run with --json to emit the pair graph instead of validating.
"""

from __future__ import annotations

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
# The three shared rules come from the workspace this project is cloned inside, reached by
# position -- the same way this repository finds `.editorconfig` and the toolchain it builds with.
# Their absence means the arrangement is wrong, and saying so by name beats a gate that quietly
# checks less. See the workspace's spec/architecture/repos.md, "Configuration is inherited by
# position, not copied".
SHARED = ROOT.parents[1] / ".mise" / "tasks" / "refs_check.py"
if not SHARED.is_file():
	sys.exit(
		f"refs: the shared reference rules are not at {SHARED}\n"
		"  A project is cloned inside the workspace that holds them, and this one is not."
	)
sys.path.insert(0, str(SHARED.parent))

from refs_check import (  # noqa: E402
	COMMENT_WRAP,
	DOC_ANCHOR,
	DOC_TAIL,
	PROSE_WRAP,
	ROOT_DOCS,
	citing_files,
	code_anchor,
	dead_anchors,
	dead_links,
	pair_graph,
	read,
	tracked,
)

# Recursive, because a spec topic large enough to need several files gets a directory rather
# than a longer file. A non-recursive glob would silently stop checking the moment one did.
DOC_GLOBS = ("spec/**/*.md", "AGENTS.md")
CODE_SUFFIXES = {
	".ts",
	".js",
	".mjs",
	".svelte",
	".html",
	".rs",
	".py",
	".css",
	".toml",
	".json",
	".jsonc",
	".yaml",
	".yml",
}
# Directories whose files are records or prose rather than code, plus the lockfile. `contents/`
# is excluded whatever the extension -- a translation sidecar is YAML by format and prose by
# nature, and asking its links to live in libs/urls would be asking an article not to cite
# anything. `data/` holds curated records, not code, and is excluded the same way.
SKIP_DIRS = {"data", "contents"}
SKIP_FILES = {"pnpm-lock.yaml"}

SPEC_REF = re.compile(rf"spec/{DOC_TAIL}")
# The root docs join the anchor check and nothing else: a bare `AGENTS.md` in code is a value in
# a config list far more often than a pointer, and a rule over those would be this tool checking
# its own configuration, which already fails loudly when it is wrong.
CODE_ANCHOR = code_anchor(rf"spec/{DOC_TAIL}|{ROOT_DOCS}")
ROOT_DOC = re.compile(ROOT_DOCS)
# The backslash ends a match so `url=\"https://a.example\"` inside a Rust format string reads
# as the address alone, not the address plus its escape.
URL = re.compile(r"https?://[^\s\"'`)\],;\\]+")
COMMENT = re.compile(r"^\s*(//|#|\*|/\*|<!--)")
# The library itself, and the generated Rust mirror a `mise run urls` writes from it -- one
# map, two languages. rust.test.ts holds the mirror to the map, so the exemption cannot hide
# an edit made to the Rust side alone.
URL_HOMES = ("libs/urls/", "apps/local/src/urls.rs")
# `$schema` keys have to be URLs because mise-installed tools have no node_modules to point
# at (spec/toolchain.md). JSON-LD's `@context` is a namespace identifier like an xmlns:
# changing it changes what the document means, not where anything points. `registry+https://`
# is cargo's own source-id syntax, quoted in test fixtures in cargo's spelling -- an
# identifier again, and not this software's to respell.
URL_EXEMPT = ('"$schema"', "'@context'", '"@context"', "registry+https://")
# Names RFC 2606 reserves so they can never resolve. A URL on one of these is a placeholder --
# for an API demanding an absolute URL, or a value a test needs rejected -- and never an
# endpoint. Exempting by rule rather than case by case is what keeps this from collecting
# exceptions. Case-insensitive because DNS is: a test probing host lowercasing spells a
# reserved name in mixed case on purpose.
URL_UNRESOLVABLE = re.compile(
	r"https?://(?:[^/\s]*\.)?(?:test|example|invalid|localhost)(?:[/:?#]|$)"
	r"|https?://(?:[^/\s]*\.)?example\.(?:com|net|org)(?:[/:?#]|$)",
	re.IGNORECASE,
)
# An XML namespace is an identifier that the specification explicitly does not require to be
# dereferenceable, and changing one changes the document's meaning rather than where it points.
# Treating these as endpoints would demand they be declared alongside hosts we actually call.
XML_NAMESPACE = re.compile(r"xmlns(?::[\w-]+)?\s*=|schemaLocation")
TEMPLATE_AUTHORITY = re.compile(r"https?://[{$]")


def docs() -> list[pathlib.Path]:
	found: list[pathlib.Path] = []
	for pattern in DOC_GLOBS:
		found.extend(sorted(ROOT.glob(pattern)))
	return found


def files() -> list[pathlib.Path]:
	return tracked(ROOT, skip_files=SKIP_FILES, skip_dirs=SKIP_DIRS)


def code_files() -> list[pathlib.Path]:
	"""Files whose URLs something other than a reader would resolve.

	Narrower than the files that may cite, and deliberately: an address written in a shell task
	is a judgement about single-sourcing that this repository has already argued out in prose,
	and widening a URL gate is not the same decision as widening a citation gate.
	"""
	return [path for path in files() if path.suffix in CODE_SUFFIXES]


def locate(cited: str) -> pathlib.Path | None:
	"""Where a cited rule is, or None when nothing from here up holds it.

	Rules that follow the author rather than this project live in the workspace above, so a
	citation of `spec/code.md` resolves one directory up. Walk rather than hardcode the depth: a
	rule this project owns answers from here and one it inherits answers from above, through the
	same call and without either having to say which it is.
	"""
	directory = ROOT
	while True:
		if (directory / cited).exists():
			return directory / cited
		if directory.parent == directory:
			return None
		directory = directory.parent


def resolve(path: pathlib.Path, cited: str) -> pathlib.Path | None:
	"""Where a citation points: up the tree for a rule, beside the citing file for a neighbour.

	A `spec/` path and a root doc are both rules, and a rule may be this project's or the
	workspace's, so both walk up. Anything else is a doc naming a neighbour of its own.
	"""
	if cited.startswith("spec/") or ROOT_DOC.fullmatch(cited):
		return locate(cited)
	return path.parent / cited


def stray_urls() -> list[str]:
	"""URLs written outside libs/urls that something other than a reader would resolve."""
	stray = []
	for path in code_files():
		rel = str(path.relative_to(ROOT))
		if rel.startswith(URL_HOMES):
			continue
		for number, line in enumerate(read(path).splitlines(), 1):
			if COMMENT.match(line) or any(token in line for token in URL_EXEMPT):
				continue
			if XML_NAMESPACE.search(line):
				continue
			for match in URL.finditer(line):
				if URL_UNRESOLVABLE.match(match.group(0)):
					continue
				# `https://{domain}/` and `https://${host}` are scheme templates: the authority
				# arrives at runtime, so there is no address here to single-source.
				if TEMPLATE_AUTHORITY.match(match.group(0)):
					continue
				stray.append(f"{rel}:{number} {match.group(0)}")
	return stray


def main() -> int:
	citing = citing_files(files(), CODE_SUFFIXES)
	graph = pair_graph(ROOT, citing, SPEC_REF)

	if "--json" in sys.argv:
		print(json.dumps(graph))
		return 0

	written = docs()
	sources = [(path, CODE_ANCHOR, COMMENT_WRAP) for path in citing]
	sources += [(doc, DOC_ANCHOR, PROSE_WRAP) for doc in written]

	dead, _ = dead_links(ROOT, written)
	stale, anchors = dead_anchors(ROOT, sources, resolve)

	problems = [f"dead link: {d}" for d in dead]
	problems += [
		f"missing spec cited by {', '.join(cited)}: {spec}"
		for spec, cited in sorted(graph.items())
		if not locate(spec)
	]
	problems += [f"missing section: {d}" for d in stale]
	problems += [
		f"URL outside {URL_HOMES[0]}: {u}  (declare it there, or make it a comment if it is a"
		f' citation -- see spec/architecture/workspace.md, "Every URL is declared once")'
		for u in stray_urls()
	]

	if problems:
		print("Reference check failed:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1

	linked = sum(len(v) for v in graph.values())
	print(
		f"references OK: {len(written)} docs, {linked} code -> spec citations, "
		f"{anchors} quoted sections, URLs single-sourced"
	)
	return 0


if __name__ == "__main__":
	sys.exit(main())
