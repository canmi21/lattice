#!/usr/bin/env python3
#MISE description="Hold the firewall rules in rules/ to what the apps serve, and deploy them: `rules [sync [zone] [--dry-run]]`"
"""With no arguments, checks `rules/` against Cloudflare's limits, each zone's `zone.toml`, and
what the apps serve -- see spec/architecture/firewall.md. `sync [zone] [--dry-run]` deploys: each
zone's rules replace what is live for each phase they use, through Cloudflare's `cf` CLI.

A zone.toml's `[[rules]]`, one per rule in order within a phase, each preceded by a `#` comment
saying why it is there: `name`, `phase`, `action`, `expression` (a .txt file, the one part that
grows, and may hold `${NAME}` -- see spec/architecture/firewall.md). A rate limit adds
`characteristics`, `period`, `requests_per_period`, `mitigation_timeout`. A redirect adds
`status` and `target`: a raw Rulesets target expression (a TOML literal string, quotes and all)
or `{ url = "<libs/urls constant>" }`, appending `path = "<path>"` when fixed and the request's
own path otherwise; either form may add `preserve_query_string = true` (default false)."""

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
RULES = ROOT / "rules"
URLS_RS = ROOT / "libs/urls/src/lib.rs"
# Cloudflare's own limit on one expression.
LIMIT = 4096
PHASES = {"http_request_firewall_custom", "http_ratelimit", "http_request_dynamic_redirect"}
ACTIONS = {"block", "redirect"}
ZONES = sorted(p.name for p in RULES.iterdir() if p.is_dir() and p.name != "all")
# Every `${NAME}` an expression may hold, filled from the environment at sync time. The probe's
# token is the first: see spec/architecture/probe.md, "The probe passes the limits it is checking
# through with a token of its own".
PLACEHOLDERS = {"PROBE_TOKEN"}
PLACEHOLDER = re.compile(r"\$\{([A-Z][A-Z0-9_]*)\}")


def placeholders_of(text):
	"""Every `${NAME}` in an expression's text, whether or not it is one of PLACEHOLDERS."""
	return PLACEHOLDER.findall(text)


def fill(text, env, *, mask):
	"""`text` with every `${NAME}` replaced from `env`, or left exactly as written when `mask` --
	`--dry-run`'s way of showing that a placeholder is there without ever reading the secret it
	stands for. Raises on a name outside PLACEHOLDERS or, unless `mask`, one absent from `env`."""

	def one(match):
		name = match.group(1)
		if name not in PLACEHOLDERS:
			raise ValueError(f"${{{name}}} is not a known placeholder")
		if mask:
			return match.group(0)
		value = env.get(name)
		if not value:
			raise ValueError(f"{name} is not set in the environment")
		return value

	return PLACEHOLDER.sub(one, text)


def urls():
	"""The generated Rust mirror of libs/urls, name -> value -- a redirect's `target` names one
	of these instead of writing a URL, per spec/architecture/workspace.md, "Every URL is
	declared once"."""
	text = URLS_RS.read_text()
	return dict(re.findall(r'pub const (\w+): &str =\s*"([^"]*)";', text))


def quoted_set(text, field):
	"""The values of `field in {...}` in an expression."""
	found = re.search(re.escape(field) + r' in \{([^}]*)\}', text)
	return set(re.findall(r'"([^"]*)"', found.group(1))) if found else set()


def parse_value(raw):
	"""One TOML scalar, array of strings, or inline table of them -- the only shapes a
	zone.toml holds. A single-quoted value is TOML's literal string, unescaped, which is what a
	redirect's `target` needs to hold a Rulesets expression's own quotes."""
	raw = raw.strip()
	if raw.startswith("{"):
		return {
			key.strip(): parse_value(value)
			for key, value in (pair.split("=", 1) for pair in raw[1:-1].split(","))
		}
	if raw.startswith("["):
		return re.findall(r'"([^"]*)"', raw)
	if raw.startswith("'"):
		return raw[1:-1]
	if raw.startswith('"'):
		return raw[1:-1]
	if raw in ("true", "false"):
		return raw == "true"
	return int(raw)


def parse_zone_toml(text):
	"""A zone's rules, in order, as a list of dicts -- a hand-rolled reader for the one shape
	zone.toml holds (arrays of tables of scalars and string arrays), since nothing in this
	toolchain's Python carries a TOML parser and the shape is small enough not to need one."""
	rules = []
	current = None
	for line in text.splitlines():
		line = line.strip()
		if not line or line.startswith("#"):
			continue
		if line == "[[rules]]":
			if current is not None:
				rules.append(current)
			current = {}
			continue
		match = re.match(r"^(\w+) = (.+)$", line)
		if not match or current is None:
			raise ValueError(f"zone.toml: unreadable line {line!r}")
		key, raw_value = match.groups()
		current[key] = parse_value(raw_value)
	if current is not None:
		rules.append(current)
	return rules


def load_zone(zone):
	"""A zone's rules, each with `expression` resolved to its path under rules/ and its text."""
	path = RULES / zone / "zone.toml"
	rules = parse_zone_toml(path.read_text())
	for rule in rules:
		expression_path = (RULES / zone / rule["expression"]).resolve()
		rule["expression_key"] = str(expression_path.relative_to(RULES.resolve()))
		# Collapsed to one line: the file wraps for readability, but the API takes one string
		# and a literal newline in it is a detail of this repository the request need not carry.
		rule["expression_text"] = " ".join(expression_path.read_text().split())
	return rules


def check():
	problems = []
	# Keyed by the path under rules/: the folder is the zone it is pasted into, `all` every zone.
	files = {str(path.relative_to(RULES)): path.read_text() for path in sorted(RULES.glob("*/*.txt"))}

	zone_rules = {}
	for zone in ZONES:
		try:
			zone_rules[zone] = load_zone(zone)
		except (ValueError, FileNotFoundError, KeyError) as error:
			problems.append(f"{zone}/zone.toml: {error}")
			zone_rules[zone] = []

	listed = set()
	for zone, rules in zone_rules.items():
		for rule in rules:
			listed.add(rule["expression_key"])
			if rule.get("phase") not in PHASES:
				problems.append(f"{zone}/zone.toml: {rule.get('name')!r} has no valid phase")
			if rule.get("action") not in ACTIONS:
				problems.append(f"{zone}/zone.toml: {rule.get('name')!r} has no valid action")
			if rule.get("phase") == "http_ratelimit":
				for field in ("characteristics", "period", "requests_per_period", "mitigation_timeout"):
					if field not in rule:
						problems.append(f"{zone}/zone.toml: {rule.get('name')!r} is a rate limit without {field}")
			if rule.get("phase") == "http_request_dynamic_redirect":
				name = rule.get("name")
				if "status" not in rule:
					problems.append(f"{zone}/zone.toml: {name!r} is a redirect without status")
				target = rule.get("target")
				if target is None:
					problems.append(f"{zone}/zone.toml: {name!r} is a redirect without target")
				elif isinstance(target, dict):
					if "url" not in target:
						problems.append(f"{zone}/zone.toml: {name!r} target names no url")
					elif target["url"] not in urls():
						problems.append(f"{zone}/zone.toml: {name!r} names an unknown libs/urls constant {target['url']!r}")
				else:
					if len(target) > LIMIT:
						problems.append(f"{zone}/zone.toml: {name!r} target is {len(target)} characters, past Cloudflare's {LIMIT}")
					if target.count("(") != target.count(")") or target.count('"') % 2:
						problems.append(f"{zone}/zone.toml: {name!r} target has unbalanced parentheses or quotes")

	for name in sorted(listed ^ set(files)):
		problems.append(f"{name}: in {'a zone.toml' if name in listed else 'rules/'} but not in {'rules/' if name in listed else 'any zone.toml'}")

	for name, text in files.items():
		if len(text) > LIMIT:
			problems.append(f"{name}: {len(text)} characters, past Cloudflare's {LIMIT}")
		if text.count("(") != text.count(")") or text.count('"') % 2:
			problems.append(f"{name}: unbalanced parentheses or quotes")
		for placeholder in placeholders_of(text):
			if placeholder not in PLACEHOLDERS:
				problems.append(f"{name}: ${{{placeholder}}} is not a known placeholder")

	# Every whitelist lets the RFC-fixed paths through, security.txt among them.
	for name, text in files.items():
		if name.endswith("-only.txt") and 'starts_with(http.request.uri.path, "/.well-known/")' not in text:
			problems.append(f"{name}: a whitelist that refuses /.well-known/")

	# Every public scope of the API host is let through, and nothing that is not one.
	scopes_ts = (ROOT / "apps/gateway/src/scopes.ts").read_text()
	scopes = set(re.findall(r"^\t(?:'|\")?([a-z0-9-]+)(?:'|\")?: \{", scopes_ts, re.M))
	allowed = set(re.findall(r'starts_with\(http\.request\.uri\.path, "/([a-z0-9-]+)/"\)', files.get("ffoni.com/api-scopes-only.txt", "")))
	for scope in sorted(scopes ^ allowed):
		problems.append(f"ffoni.com/api-scopes-only.txt: /{scope}/ is {'a scope it refuses' if scope in scopes else 'let through but no scope'}")

	# The zone's rate limit counts everything but the CDN and GitHub's webhook, so a new scope is
	# counted unnamed. Each CDN prefix is left out, but the old `/github/`, a redirect, which
	# is counted; and each prefix left out is the CDN's or the webhook's. See the spec.
	prefix = r'starts_with\(http\.request\.uri\.path, "(/[^"]+)"\)'
	cdn = set(re.findall(prefix, files.get("ffoni.com/cdn-prefixes-only.txt", ""))) - {"/.well-known/", "/github/"}
	cap = files.get("ffoni.com/rate-cap.txt", "")
	left = set(re.findall(prefix, cap))
	if 'http.request.uri.path wildcard "/*/*"' not in cap:
		problems.append("ffoni.com/rate-cap.txt: does not count every scoped path")
	for path in sorted(cdn):
		if not any(path.startswith(out) for out in left):
			problems.append(f"ffoni.com/rate-cap.txt: the CDN's {path} is counted")
	for out in sorted(left - {"/hook/"}):
		if not any(path.startswith(out) for path in cdn):
			problems.append(f"ffoni.com/rate-cap.txt: {out} is left out, and not the CDN's")

	# Every extension the site's routes and public files are named with is let through.
	site = ROOT / "apps/site"
	# A route is a directory, named as the address it answers; `[...rest]` is a pattern, not a file.
	routes = [p.name for p in (site / "src/routes").rglob("*") if p.is_dir() and not p.name.startswith("[...")]
	names = routes + [p.name for p in (site / "public").rglob("*") if p.is_file()]
	served = {name.rsplit(".", 1)[1].lower() for name in names if "." in name.lstrip(".")}
	extensions = quoted_set(files.get("canmi.net/site-files-only.txt", ""), "http.request.uri.path.extension")
	for extension in sorted(served - extensions):
		problems.append(f"canmi.net/site-files-only.txt: the site serves .{extension} and the rule refuses it")

	if problems:
		print("Firewall rules out of step:\n")
		for problem in problems:
			print(f"  {problem}")
		print("\nChange the rule in rules/ and run `mise run rules sync` to deploy; see spec/architecture/firewall.md.")
		return 1
	print(f"rules OK: {len(files)} rule files across {len(ZONES)} zones, each within {LIMIT} characters and in step with the apps")
	return 0


def rule_body(rule):
	"""One rule of a phase's ruleset body, in the shape the Rulesets API takes."""
	body = {
		"description": rule["name"],
		"expression": rule["expression_text"],
		"action": rule["action"],
	}
	if rule["phase"] == "http_ratelimit":
		body["ratelimit"] = {
			"characteristics": rule["characteristics"],
			"period": rule["period"],
			"requests_per_period": rule["requests_per_period"],
			"mitigation_timeout": rule["mitigation_timeout"],
		}
	if rule["phase"] == "http_request_dynamic_redirect":
		target = rule["target"]
		if isinstance(target, dict):
			base = urls()[target["url"]]
			if "path" in target:
				target_url = {"value": base + target["path"]}
			else:
				target_url = {"expression": f'concat("{base}", http.request.uri.path)'}
		else:
			target_url = {"expression": target}
		body["action_parameters"] = {
			"from_value": {
				"status_code": rule["status"],
				"target_url": target_url,
				"preserve_query_string": rule.get("preserve_query_string", False),
			}
		}
	return body


def phase_bodies(zone, env, *, mask):
	"""zone's rules grouped by phase, each a ruleset body: `{"rules": [...]}`, in zone.toml order.
	Each rule's expression has had `fill` run over it -- see the module docstring."""
	bodies = {}
	for rule in load_zone(zone):
		filled = {**rule, "expression_text": fill(rule["expression_text"], env, mask=mask)}
		bodies.setdefault(rule["phase"], {"rules": []})["rules"].append(rule_body(filled))
	return bodies


def sync(zone_arg, dry_run):
	zones = [zone_arg] if zone_arg else ZONES
	for zone in zones:
		if zone not in ZONES:
			print(f"sync: no rules/{zone}/zone.toml", file=sys.stderr)
			return 1

	token = os.environ.get("CLOUDFLARE_ZONES_TOKEN")
	if not token and not dry_run:
		print(
			"sync: CLOUDFLARE_ZONES_TOKEN is not set. It must come from the repository's encrypted "
			"secrets.json (see spec/toolchain.md, \"Secrets\"), decrypted by mise on entering the "
			"directory, like HOST_TOKEN. Refusing rather than falling back to cf's own login.",
			file=sys.stderr,
		)
		return 1

	env = dict(os.environ)
	if token:
		# cf reads CLOUDFLARE_API_TOKEN before any stored OAuth profile, so setting it here is
		# what keeps the account's own login out of a script's reach.
		env["CLOUDFLARE_API_TOKEN"] = token

	def command(phase, zone, body_path, validate_only):
		base = ["cf", "rulesets", "account-rulesets", "phases", "update", phase, "-z", zone, "--body", f"@{body_path}"]
		return base + ["--validate-only"] if validate_only else base

	for zone in zones:
		try:
			bodies = phase_bodies(zone, env, mask=dry_run)
		except ValueError as error:
			print(f"sync: {zone}: {error}", file=sys.stderr)
			return 1
		texts = {phase: json.dumps(body, indent="\t") + "\n" for phase, body in bodies.items()}

		if dry_run:
			for phase, text in texts.items():
				print(f"--- {zone} {phase} ---")
				print(text)
			print(f"{zone}: would run, after every phase validates:")
			for phase in texts:
				print("  " + " ".join(command(phase, zone, f"<{phase}.json>", False)))
			continue

		paths = {}
		for phase, text in texts.items():
			with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as handle:
				handle.write(text)
				paths[phase] = handle.name
		try:
			for phase, body_path in paths.items():
				validated = subprocess.run(command(phase, zone, body_path, True), env=env, cwd=ROOT)
				if validated.returncode != 0:
					print(f"sync: {zone} {phase} failed validation, nothing applied for {zone}", file=sys.stderr)
					return 1
			for phase, body_path in paths.items():
				applied = subprocess.run(command(phase, zone, body_path, False), env=env, cwd=ROOT)
				if applied.returncode != 0:
					print(f"sync: {zone} {phase} failed to apply", file=sys.stderr)
					return 1
		finally:
			for body_path in paths.values():
				Path(body_path).unlink(missing_ok=True)
		print(f"{zone}: synced")
	return 0


def main():
	args = sys.argv[1:]
	if args and args[0] == "sync":
		dry_run = "--dry-run" in args[1:]
		rest = [a for a in args[1:] if a != "--dry-run"]
		zone_arg = rest[0] if rest else None
		return sync(zone_arg, dry_run)
	return check()


if __name__ == "__main__":
	sys.exit(main())
