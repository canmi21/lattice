#!/usr/bin/env bash
#MISE description="Say which generation the live corpus is, against the one this source expects"
set -euo pipefail

# What the live corpus is, next to what this build can read. `ARTIFACT_VERSION` says which
# generation this source understands and the bucket root says which is out there; they move on
# separate schedules, and nothing measured the distance until this did.
#
# **This warns and never refuses**, and not being able to ask is not a failure either: the gap
# is normally minutes, and a check that blocked the deploy would be wrong more often than right.
# See spec/architecture/artifacts.md, "A build says how far the live corpus is from it".

BASE="$(cd "$(dirname "$0")/../.." && pwd)"
INDEX="$BASE/libs/artifacts/src/index.ts"

WANTED="$(sed -n 's/^export const ARTIFACT_VERSION = \([0-9]*\);$/\1/p' "$INDEX")"
if [ -z "$WANTED" ]; then
	echo "generation: no ARTIFACT_VERSION in ${INDEX#"$BASE"/}, skipping the check" >&2
	exit 0
fi

REMOTE="${R2_METADATA_REMOTE:-}"
if [ -z "$REMOTE" ]; then
	echo "generation: R2_METADATA_REMOTE is unset, so the live corpus was not asked"
	echo "generation: this source reads generation $WANTED"
	exit 0
fi

# The root is the one mutable object and the only one that has to be current, so it is what is
# asked. `|| true` because every failure here -- no credential, no network, no bucket -- is a
# check that could not run rather than an answer.
LIVE="$(rclone cat "$REMOTE/state/index.json" 2>/dev/null || true)"
if [ -z "$LIVE" ]; then
	echo "generation: could not read $REMOTE/state/index.json, so the live corpus was not asked"
	echo "generation: this source reads generation $WANTED"
	exit 0
fi

read -r PUBLISHED GENERATED <<EOF
$(printf '%s' "$LIVE" | python3 -c '
import json, sys
try:
	root = json.load(sys.stdin)
except Exception:
	print("? ?")
else:
	print(root.get("version", "?"), root.get("generated", "?"))
')
EOF

if [ "$PUBLISHED" = "?" ]; then
	echo "generation: the live root did not parse, so its generation is unknown"
	echo "generation: this source reads generation $WANTED"
	exit 0
fi

if [ "$PUBLISHED" = "$WANTED" ]; then
	echo "generation: live corpus is $PUBLISHED, published $GENERATED -- this source reads $WANTED"
	exit 0
fi

echo
if [ "$PUBLISHED" -lt "$WANTED" ] 2>/dev/null; then
	echo "WARNING: the live corpus is a generation behind this source."
	echo "  live      generation $PUBLISHED, published $GENERATED"
	echo "  this code reads generation $WANTED"
	echo
	echo "  Deploying is allowed and this is not stopping it. Until \`mise run publish lattice"
	echo "  --live\` has run, a worker built from this source is reading objects written under an"
	echo "  older shape, and what that costs is whatever the two generations disagree about."
else
	echo "WARNING: the live corpus is ahead of this source."
	echo "  live      generation $PUBLISHED, published $GENERATED"
	echo "  this code reads generation $WANTED"
	echo
	echo "  Somebody published from a newer source than this one. Deploying this build would take"
	echo "  the site back a generation; pull before you do."
fi
echo
exit 0
