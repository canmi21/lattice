#!/usr/bin/env python3
#MISE description="Hold every comment block to the length and width the house rules give it"
"""Measure every comment block in the repository against the limits in spec/code.md.

Three numbers, none of them this project's: a block is at most six body lines, the block opening
a file gets ten, and a comment line stays inside 100 columns with tabs at two -- the width
oxfmt's printWidth and rustfmt's max_width already give code, and which neither of them rewraps,
so it is the one held by hand.

A body line is one carrying text. `/**`, `*/`, a blank `*` and a docstring's closing quotes are
punctuation, and a JSDoc block spends about two lines on them, so counting those would make the
same limit mean less in one language than in another.

Pass paths to measure those instead of the whole tree.
"""

from __future__ import annotations

import ast
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
WIDTH = 100
BODY = 6
OPENING = 10
# A fenced block inside a document illustrates code rather than being it, and nothing in the
# text says which, so a Markdown file is read by people and not by this.
SKIPPED = (".md",)
# Opening a block, in the order they have to be tried: `///` before `//`, or the shorter one
# matches first and leaves a stray slash inside the text it was meant to take off. `#` is a
# comment only when a space or the line end follows it -- `#[derive]`, `#id {` and `#fff` are
# code in three languages that would otherwise read as prose.
OPENERS = ("///", "//!", "//", "/**", "/*", "*/", "<!--", '"""', "'''", "#")
CLOSERS = ("*/", "-->", '"""', "'''")
# Read by a tool rather than by a person. A shell script cannot put its introduction first --
# the shebang, mise's task header and `set -euo pipefail` have to lead -- and none of them is
# prose, so the block after them is still the one that opens the file.
DIRECTIVES = ("#!", "#MISE", "#USAGE")
PREAMBLE = ("set -",)


def columns(line: str) -> int:
	"""The width oxfmt and rustfmt would count, which is tabs at two."""
	return len(line.expandtabs(2))


def text_of(line: str) -> str:
	"""What one comment line says, with its markers taken off."""
	stripped = line.strip()
	for opener in OPENERS:
		if stripped.startswith(opener):
			stripped = stripped[len(opener) :]
			break
	for closer in CLOSERS:
		if stripped.endswith(closer):
			stripped = stripped[: -len(closer)]
	return stripped.lstrip("*").strip()


def hashed(bare: str) -> bool:
	"""Whether a stripped line opens or continues a `#` comment rather than naming something."""
	return (bare == "#" or bare.startswith(("# ", "#\t"))) and not bare.startswith(DIRECTIVES)


def generated(lines: list[str]) -> bool:
	"""Whether a tool wrote this file, in which case its comments are nobody's to fix.

	A check reporting a line that may not be edited teaches its reader to skip the output, so
	the exemption is the tool's job rather than a note in a brief. Wrangler's
	`worker-configuration` is the one here, and it says so on its second line.
	"""
	head = " ".join(lines[:5]).lower()
	return "generated by" in head or "@generated" in head or "do not edit" in head


def docstrings(lines: list[str]) -> tuple[list[tuple[int, int, int, bool]], set[int]]:
	"""Python's comment blocks, which carry no marker a line scan could find, and their lines.

	A module docstring introduces the whole file and takes the opening limit. One on a callable
	introduces strictly less than a file and takes the ordinary six: spec/code.md rations prose
	by what every future read costs, and already counts a docstring among the costs it rations.
	"""
	try:
		tree = ast.parse("\n".join(lines))
	except (SyntaxError, ValueError):
		return [], set()

	found = []
	claimed = set()
	holders = (ast.Module, ast.AsyncFunctionDef, ast.FunctionDef, ast.ClassDef)
	for node in ast.walk(tree):
		if not isinstance(node, holders):
			continue
		first = node.body[0] if node.body else None
		if not isinstance(first, ast.Expr) or not isinstance(first.value, ast.Constant):
			continue
		if not isinstance(first.value.value, str) or first.end_lineno is None:
			continue
		span = range(first.lineno, first.end_lineno + 1)
		body = [lines[number - 1] for number in span]
		claimed.update(span)
		count = sum(1 for line in body if text_of(line))
		widest = max(columns(line) for line in body)
		found.append((first.lineno, count, widest, isinstance(node, ast.Module)))
	return found, claimed


def blocks(path: pathlib.Path) -> list[tuple[int, int, int, bool]]:
	"""Every comment block in a file: line number, body lines, widest column, opens the file."""
	try:
		lines = path.read_text().split("\n")
	except (OSError, UnicodeDecodeError):
		return []
	if generated(lines):
		return []

	python = path.suffix == ".py" or (bool(lines) and "python" in lines[0])
	found, claimed = docstrings(lines) if python else ([], set())

	code_seen = False
	index = 0
	while index < len(lines):
		start = index
		bare = lines[index].strip()
		if bare.startswith(DIRECTIVES) or (not code_seen and bare.startswith(PREAMBLE)):
			index += 1
			continue
		if index + 1 in claimed:
			code_seen = True
			index += 1
			continue
		if bare.startswith(("/*", "<!--")):
			closer = "*/" if bare.startswith("/*") else "-->"
			while index < len(lines) and closer not in lines[index]:
				index += 1
			index = min(index, len(lines) - 1)
			body = lines[start : index + 1]
			index += 1
		elif bare.startswith("//"):
			while index < len(lines) and lines[index].strip().startswith("//"):
				index += 1
			body = lines[start:index]
		elif hashed(bare):
			while index < len(lines) and hashed(lines[index].strip()):
				index += 1
			body = lines[start:index]
		else:
			code_seen = code_seen or bool(bare)
			index += 1
			continue
		widest = max(columns(line) for line in body)
		found.append((start + 1, sum(1 for line in body if text_of(line)), widest, not code_seen))
	return sorted(found)


def files(argv: list[str]) -> list[pathlib.Path]:
	"""The files to measure: everything version control lists, or the paths given.

	The scope is the whole tree rather than a list of directories, because a checker told about
	each directory is blind to the next one -- which is how `.mise/tasks/`, holding the longest
	blocks here, went unmeasured. `.gitignore` is already the one home of "this is output, not
	code", and a file no decoder can read carries no prose to measure.
	"""
	if argv:
		return [pathlib.Path(name) for name in argv]
	listing = subprocess.run(
		["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
		capture_output=True,
		text=True,
		check=True,
	)
	return [ROOT / name for name in listing.stdout.split("\0") if name and not name.endswith(SKIPPED)]


def main(argv: list[str]) -> int:
	over = []
	counted = 0
	for path in files(argv):
		name = path.relative_to(ROOT) if path.is_relative_to(ROOT) else path
		for line, body, widest, opening in blocks(path):
			counted += 1
			limit = OPENING if opening else BODY
			why = []
			if widest > WIDTH:
				why.append(f"{widest} columns over {WIDTH}")
			if body > limit:
				why.append(f"{body} body lines over {limit}")
			if why:
				over.append(f"{name}:{line}  {', '.join(why)}")

	if over:
		print("Comment blocks over a limit:\n", file=sys.stderr)
		for problem in over:
			print(f"  {problem}", file=sys.stderr)
		print(
			"\nCut to the line that carries the point. A fact a second file would need is a rule "
			"and belongs in spec/; one only this file needs stays here, in fewer words. See "
			'spec/code.md, "How long, and where the rest of it goes".',
			file=sys.stderr,
		)
		return 1

	print(f"comments OK: {counted} blocks inside {BODY}/{OPENING} body lines and {WIDTH} columns")
	return 0


if __name__ == "__main__":
	sys.exit(main(sys.argv[1:]))
