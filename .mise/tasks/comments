#!/usr/bin/env python3
#MISE description="Hold every comment block to the length and width the house rules give it"
"""Measure the comment blocks under apps/ and libs/ against the limits in spec/code.md.

Three numbers, none of them this project's: a block is at most six body lines, the block opening
a file gets ten, and a comment line stays inside 100 columns with tabs at two -- the width
oxfmt's printWidth and rustfmt's max_width already give code, and which neither of them rewraps,
so it is the one held by hand.

A body line is one carrying text. `/**`, `*/` and a blank `*` are punctuation, and a JSDoc block
spends about two lines on them, so counting those would make the same limit mean less in one
language than in another.

Pass paths to measure those instead of the whole tree.
"""

from __future__ import annotations

import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
WIDTH = 100
BODY = 6
OPENING = 10
ROOTS = ("apps/", "libs/")
SUFFIXES = (".ts", ".tsx", ".js", ".mjs", ".cjs", ".svelte", ".rs", ".css")
# Opening a block, in the order they have to be tried: `///` before `//`, or the shorter one
# matches first and leaves a stray slash inside the text it was meant to take off.
OPENERS = ("///", "//!", "//", "/**", "/*", "*/", "<!--")
CLOSERS = ("*/", "-->")


def columns(line: str) -> int:
	"""The width oxfmt and rustfmt would count, which is tabs at two."""
	return len(line.expandtabs(2))


def text_of(line: str) -> str:
	"""What one comment line says, with its markers taken off."""
	stripped = line.strip()
	for opener in OPENERS:
		if stripped.startswith(opener):
			stripped = stripped[len(opener) :]
			break
	for closer in CLOSERS:
		if stripped.endswith(closer):
			stripped = stripped[: -len(closer)]
	return stripped.lstrip("*").strip()


def generated(lines: list[str]) -> bool:
	"""Whether a tool wrote this file, in which case its comments are nobody's to fix.

	A check reporting a line that may not be edited teaches its reader to skip the output, so
	the exemption is the tool's job rather than a note in a brief. Wrangler's
	`worker-configuration` is the one here, and it says so on its second line.
	"""
	head = " ".join(lines[:5]).lower()
	return "generated by" in head or "@generated" in head or "do not edit" in head


def blocks(path: pathlib.Path) -> list[tuple[int, int, int, bool]]:
	"""Every comment block in a file: line number, body lines, widest column, opens the file."""
	try:
		lines = path.read_text().split("\n")
	except (OSError, UnicodeDecodeError):
		return []
	if generated(lines):
		return []

	found = []
	code_seen = False
	index = 0
	while index < len(lines):
		start = index
		bare = lines[index].strip()
		if bare.startswith(("/*", "<!--")):
			closer = "*/" if bare.startswith("/*") else "-->"
			while index < len(lines) and closer not in lines[index]:
				index += 1
			index = min(index, len(lines) - 1)
			body = lines[start : index + 1]
			index += 1
		elif bare.startswith("//"):
			while index < len(lines) and lines[index].strip().startswith("//"):
				index += 1
			body = lines[start:index]
		else:
			code_seen = code_seen or bool(bare)
			index += 1
			continue
		widest = max(columns(line) for line in body)
		found.append((start + 1, sum(1 for line in body if text_of(line)), widest, not code_seen))
	return found


def files(argv: list[str]) -> list[pathlib.Path]:
	"""The files to measure: what git lists under apps/ and libs/, or the paths given.

	`.gitignore` is already the one home of "this is output, not code", so the listing is taken
	from there rather than from a second list of directory names. The one this replaced skipped
	any directory called `build`, which exempted apps/site/src/lib/content/build -- source that
	merely shares a name with output, and seventeen files nobody had measured.
	"""
	if argv:
		return [pathlib.Path(name) for name in argv]
	listing = subprocess.run(
		["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
		capture_output=True,
		text=True,
		check=True,
	)
	return [
		ROOT / name
		for name in listing.stdout.split("\0")
		if name.startswith(ROOTS) and name.endswith(SUFFIXES)
	]


def main(argv: list[str]) -> int:
	over = []
	counted = 0
	for path in files(argv):
		name = path.relative_to(ROOT) if path.is_relative_to(ROOT) else path
		for line, body, widest, opening in blocks(path):
			counted += 1
			limit = OPENING if opening else BODY
			why = []
			if widest > WIDTH:
				why.append(f"{widest} columns over {WIDTH}")
			if body > limit:
				why.append(f"{body} body lines over {limit}")
			if why:
				over.append(f"{name}:{line}  {', '.join(why)}")

	if over:
		print("Comment blocks over a limit:\n", file=sys.stderr)
		for problem in over:
			print(f"  {problem}", file=sys.stderr)
		print(
			"\nCut to the line that carries the point. A fact a second file would need is a rule "
			"and belongs in spec/; one only this file needs stays here, in fewer words. See "
			'spec/code.md, "How long, and where the rest of it goes".',
			file=sys.stderr,
		)
		return 1

	print(f"comments OK: {counted} blocks inside {BODY}/{OPENING} body lines and {WIDTH} columns")
	return 0


if __name__ == "__main__":
	sys.exit(main(sys.argv[1:]))
