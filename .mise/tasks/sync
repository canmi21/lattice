#!/usr/bin/env bash
#MISE description="Mirror the published trees to their R2 buckets (dry run unless --live)"
set -euo pipefail

# The publication gate. Whether a file reaches the internet is decided here and nowhere else.
#
# What makes it fail closed is the SOURCE path, not the filter file: rclone is pointed at the two
# published trees and can never see anything else under data/, so a directory added later is
# excluded because it was never in scope. The two failure modes are not symmetric -- miss a
# denylist rule and a draft publishes silently, get this wrong and a file fails to appear.
#
# **`sync` rather than `copy`, for every tree**, because a bucket is a mirror and one that keeps
# what the source dropped diverges invisibly. Which is also why the default is a dry run.
# See spec/architecture/data.md, "One bucket holds records and the other holds bytes", and
# spec/architecture/artifacts.md, "An object is swept an hour after nothing names it".

BASE="$(cd "$(dirname "$0")/../.." && pwd)"
OBJECTS="$BASE/data/bucket/objects"
METADATA="$BASE/data/bucket/metadata"

DRAFT="$BASE/data/bucket/draft"

for tree in "$OBJECTS" "$METADATA"; do
	if [ ! -d "$tree" ]; then
		echo "refusing to sync: $tree does not exist" >&2
		echo "an empty or wrong source would delete the entire bucket" >&2
		exit 1
	fi
	# The draft tree is bucket-shaped and sits beside the two mirrors, which puts it exactly one
	# directory level away from being published. Asserted rather than assumed: aiming a source at
	# the parent instead of the leaf would publish every draft, and nothing else here would notice.
	case "$DRAFT" in
	"$tree"/*)
		echo "refusing to sync: $tree contains the draft tree" >&2
		echo "a source must name a mirror, never the directory holding them" >&2
		exit 1
		;;
	esac
done

OBJECTS_REMOTE="${R2_OBJECTS_REMOTE:-}"
METADATA_REMOTE="${R2_METADATA_REMOTE:-}"

if [ -z "$OBJECTS_REMOTE" ] || [ -z "$METADATA_REMOTE" ]; then
	echo "set both rclone destinations, for example:" >&2
	echo "  set -gx R2_OBJECTS_REMOTE r2:objects" >&2
	echo "  set -gx R2_METADATA_REMOTE r2:metadata" >&2
	echo "credentials belong in rclone's own config, never in this repo" >&2
	exit 1
fi

# Every argument, not just the first. mise appends a task's whole argument list to its last
# command, so this is reached as `sync lattice --live` as often as `sync --live` -- and reading `$1`
# alone made the first of those a dry run that reported success. The flag is what is looked for,
# wherever it lands.
MODE=(--dry-run)
for argument in "$@"; do
	if [ "$argument" = "--live" ]; then
		MODE=()
	fi
done

# `${MODE[@]+...}` rather than a bare `"${MODE[@]}"`: macOS ships bash 3.2, where expanding an
# empty array under `set -u` is an unbound variable and aborts the script. Which meant `--live`
# -- the one branch that empties the array -- had never run on this machine, while the dry run
# it defaults to worked perfectly and hid it.

# One filter list, and it is a file. Every tree is mirrored the same way now, so nothing here
# selects what a transfer may touch -- the source path already did that -- and all that is left is
# dropping junk that landed inside a published tree. Rules are first-match-wins, and never
# --include beside --exclude: rclone parses those two in an indeterminate order and says so.
JUNK=(--filter-from "$(dirname "$0")/sync.filter")

# --delete-after is rclone's default; it is written out because it is load-bearing here rather
# than incidental. See the ordering note below.
COMMON=(--progress --delete-after ${MODE[@]+"${MODE[@]}"})

# Three transfers in one order, and the order is the whole of it. An object has to be readable
# before a root names it, or the root produces a 404 held for five minutes on a key that becomes
# valid a second later; `set -e` between the steps is what makes that a guarantee.
#
# Deletion wants the opposite order, and --delete-after is as far as one run can go: nothing
# leaves a bucket until everything that transfer publishes has landed. The rest of the distance
# is `cms gc` waiting an hour, which is longer than any root is cached.
rclone sync "$OBJECTS" "$OBJECTS_REMOTE" "${JUNK[@]}" --track-renames "${COMMON[@]}"
rclone sync "$METADATA/meta" "$METADATA_REMOTE/meta" "${JUNK[@]}" --track-renames "${COMMON[@]}"
rclone sync "$METADATA/state" "$METADATA_REMOTE/state" "${JUNK[@]}" "${COMMON[@]}"
