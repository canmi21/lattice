#!/usr/bin/env bash
#MISE description="Mirror data/public to the R2 bucket (dry run unless --live)"
set -euo pipefail

# The publication gate. Whether a file reaches the internet is decided here and nowhere else.
#
# What makes it fail closed is the SOURCE path, not the filter file: rclone is pointed at
# data/public and can never see anything else under data/. A directory added later --
# raw originals, exports, scratch -- is excluded because it was never in scope, with no rule
# needed and none to forget. The filter only drops junk that lands inside data/public itself.
#
# Structuring it this way rather than as "sync data/ minus a denylist" is deliberate. The two
# failure modes are not symmetric: miss a denylist rule and a draft is published silently,
# with nothing to notice; get this wrong and a file merely fails to appear, which shows up the
# first time you look for it.
#
# `sync` rather than `copy`: the bucket is a mirror, so deleting locally has to delete
# remotely. That also makes a wrong SOURCE path destructive -- hence the guard below and the
# dry run by default.
#
# The content-addressed prefixes are the exception and are copied. Deleting one would remove an
# object that a root still in somebody's cache is naming, five minutes after it stopped being
# current; a sweep removes them later, when nothing can still ask. See
# spec/architecture/artifacts.md, "Publication is ordered, and deletion is not part of it".

SOURCE="$(cd "$(dirname "$0")/../.." && pwd)/data/public"
REMOTE="${R2_REMOTE:-}"

if [ ! -d "$SOURCE" ]; then
	echo "refusing to sync: $SOURCE does not exist" >&2
	echo "an empty or wrong source would delete the entire bucket" >&2
	exit 1
fi

if [ -z "$REMOTE" ]; then
	echo "set R2_REMOTE to the rclone destination, for example:" >&2
	echo "  set -gx R2_REMOTE r2:my-bucket" >&2
	echo "credentials belong in rclone's own config, never in this repo" >&2
	exit 1
fi

# Every argument, not just the first. mise appends a task's whole argument list to its last
# command, so this is reached as `sync press --live` as often as `sync --live` -- and reading `$1`
# alone made the first of those a dry run that reported success. The flag is what is looked for,
# wherever it lands.
MODE=(--dry-run)
for argument in "$@"; do
	if [ "$argument" = "--live" ]; then
		MODE=()
	fi
done

# `${MODE[@]+...}` rather than a bare `"${MODE[@]}"`: macOS ships bash 3.2, where expanding an
# empty array under `set -u` is an unbound variable and aborts the script. Which meant `--live`
# -- the one branch that empties the array -- had never run on this machine, while the dry run
# it defaults to worked perfectly and hid it.

# The prefixes are read from the contract rather than written here a second time. A list that
# drifts from ARTIFACT_TYPES would silently start deleting a type nobody added to this file.
CONTRACT="$(cd "$(dirname "$0")/../.." && pwd)/libs/artifacts/src/index.ts"
read -r ROOT TYPES <<<"$(node --input-type=module -e \
	"import { ARTIFACT_TYPES, ROOT_KEY } from '$CONTRACT';
	 console.log(ROOT_KEY, ARTIFACT_TYPES.join(' '))")"

# One filter list per phase, never --include beside --exclude: rclone parses those two in an
# indeterminate order and says so. Rules are first-match-wins, so the junk list goes first.
JUNK=(--filter-from "$(dirname "$0")/sync.filter")

ONLY_IMMUTABLE=("${JUNK[@]}")
NOT_IMMUTABLE=("${JUNK[@]}" --filter "- /$ROOT")
for type in $TYPES; do
	ONLY_IMMUTABLE+=(--filter "+ /$type/**")
	NOT_IMMUTABLE+=(--filter "- /$type/**")
done
ONLY_IMMUTABLE+=(--filter "- *")

COMMON=(--progress ${MODE[@]+"${MODE[@]}"})

# Three transfers in one order, and the order is the whole of it. An object named by its own hash
# has to be readable before a root names it: a root that arrives first produces a 404 that is then
# held for five minutes on a key that becomes valid a second later. Each step exits non-zero on a
# failed transfer and `set -e` stops the next one, which is what makes the ordering a guarantee
# rather than a hope.
rclone copy "$SOURCE" "$REMOTE" "${ONLY_IMMUTABLE[@]}" "${COMMON[@]}"
rclone sync "$SOURCE" "$REMOTE" "${NOT_IMMUTABLE[@]}" --track-renames "${COMMON[@]}"
rclone copy "$SOURCE/$(dirname "$ROOT")" "$REMOTE/$(dirname "$ROOT")" "${JUNK[@]}" "${COMMON[@]}"
