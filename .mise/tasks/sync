#!/usr/bin/env bash
#MISE description="Mirror the published trees to their R2 buckets (dry run unless --live)"
set -euo pipefail

# The publication gate. Whether a file reaches the internet is decided here and nowhere else.
#
# What makes it fail closed is the SOURCE path, not the filter file: rclone is pointed at the two
# published trees and can never see anything else under data/. A directory added later -- raw
# originals, exports, scratch -- is excluded because it was never in scope, with no rule needed and
# none to forget. The filter only drops junk that lands inside a published tree itself.
#
# Structuring it this way rather than as "sync data/ minus a denylist" is deliberate. The two
# failure modes are not symmetric: miss a denylist rule and a draft is published silently, with
# nothing to notice; get this wrong and a file merely fails to appear, which shows up the first
# time you look for it.
#
# **Two trees and two buckets**, because the API reads one and the CDN serves the other and
# neither should hold a credential for both. See spec/architecture/data.md, "One bucket holds
# records and the other holds bytes".
#
# **`sync` rather than `copy`, for every tree without exception.** A bucket is a mirror: what is
# here goes up, what is not here is deleted. A mirror that keeps what the source dropped is not a
# mirror, and the divergence is invisible -- nothing reports it, and it grows. That also makes a
# wrong SOURCE path destructive, which is what the guards below and the dry run by default are for.
#
# The content-addressed prefixes used to be copied instead, so the bucket would keep an object a
# root still in somebody's cache is naming. That reasoning was right and was being applied in the
# wrong place: the window it protects is a property of *when a sweep may delete*, not of what a
# mirror may transfer, and holding it here made the local tree and the bucket disagree forever
# while the sweep deleted with no delay at all. `cms gc` now waits an hour after an object stops
# being named, and the mirror simply mirrors. See spec/architecture/artifacts.md, "An object is
# swept an hour after nothing names it".

BASE="$(cd "$(dirname "$0")/../.." && pwd)"
OBJECTS="$BASE/data/bucket/objects"
METADATA="$BASE/data/bucket/metadata"

DRAFT="$BASE/data/bucket/draft"

for tree in "$OBJECTS" "$METADATA"; do
	if [ ! -d "$tree" ]; then
		echo "refusing to sync: $tree does not exist" >&2
		echo "an empty or wrong source would delete the entire bucket" >&2
		exit 1
	fi
	# The draft tree is bucket-shaped and sits beside the two mirrors, which puts it exactly one
	# directory level away from being published. Asserted rather than assumed: aiming a source at
	# the parent instead of the leaf would publish every draft, and nothing else here would notice.
	case "$DRAFT" in
	"$tree"/*)
		echo "refusing to sync: $tree contains the draft tree" >&2
		echo "a source must name a mirror, never the directory holding them" >&2
		exit 1
		;;
	esac
done

OBJECTS_REMOTE="${R2_OBJECTS_REMOTE:-}"
METADATA_REMOTE="${R2_METADATA_REMOTE:-}"

if [ -z "$OBJECTS_REMOTE" ] || [ -z "$METADATA_REMOTE" ]; then
	echo "set both rclone destinations, for example:" >&2
	echo "  set -gx R2_OBJECTS_REMOTE r2:objects" >&2
	echo "  set -gx R2_METADATA_REMOTE r2:metadata" >&2
	echo "credentials belong in rclone's own config, never in this repo" >&2
	exit 1
fi

# Every argument, not just the first. mise appends a task's whole argument list to its last
# command, so this is reached as `sync press --live` as often as `sync --live` -- and reading `$1`
# alone made the first of those a dry run that reported success. The flag is what is looked for,
# wherever it lands.
MODE=(--dry-run)
for argument in "$@"; do
	if [ "$argument" = "--live" ]; then
		MODE=()
	fi
done

# `${MODE[@]+...}` rather than a bare `"${MODE[@]}"`: macOS ships bash 3.2, where expanding an
# empty array under `set -u` is an unbound variable and aborts the script. Which meant `--live`
# -- the one branch that empties the array -- had never run on this machine, while the dry run
# it defaults to worked perfectly and hid it.

# One filter list, and it is a file. Every tree is mirrored the same way now, so nothing here
# selects what a transfer may touch -- the source path already did that -- and all that is left is
# dropping junk that landed inside a published tree. Rules are first-match-wins, and never
# --include beside --exclude: rclone parses those two in an indeterminate order and says so.
JUNK=(--filter-from "$(dirname "$0")/sync.filter")

# --delete-after is rclone's default; it is written out because it is load-bearing here rather
# than incidental. See the ordering note below.
COMMON=(--progress --delete-after ${MODE[@]+"${MODE[@]}"})

# Three transfers in one order, and the order is the whole of it. An object named by its own hash
# has to be readable before a root names it: a root that arrives first produces a 404 that is then
# held for five minutes on a key that becomes valid a second later. Each step exits non-zero on a
# failed transfer and `set -e` stops the next one, which is what makes the ordering a guarantee
# rather than a hope. The root goes last of all, and it is in the other bucket now.
#
# **Deletion is the mirror image and wants the opposite order.** An object has to stop being named
# before it stops being readable, so a delete belongs after the new root is up, not before it --
# for the whole of a run the live root is still the previous one, and it names what this run is
# about to remove. rclone binds a delete to the transfer that discovered it, so inside one run
# --delete-after is as far as that goes: nothing leaves a bucket until everything that transfer
# publishes has landed, and a run that fails partway leaves a superset rather than a hole.
#
# The rest of the distance is deliberately not the mirror's to cover. What a cached root still
# names is kept alive by `cms gc` waiting an hour before it deletes anything locally, so by the
# time a key reaches this file as a deletion it stopped being named an hour ago -- longer than any
# root is cached. Reversing the transfer order to close the remainder would break the upload
# guarantee above, which protects the answer that actually cannot be cached.
rclone sync "$OBJECTS" "$OBJECTS_REMOTE" "${JUNK[@]}" --track-renames "${COMMON[@]}"
rclone sync "$METADATA/meta" "$METADATA_REMOTE/meta" "${JUNK[@]}" --track-renames "${COMMON[@]}"
rclone sync "$METADATA/state" "$METADATA_REMOTE/state" "${JUNK[@]}" "${COMMON[@]}"
