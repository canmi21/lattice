#!/usr/bin/env python3
#MISE description="Every gate a change reaches: `verify [--all] [--since REV] [--dry-run] [--files ...]`"
"""The gates a change has to pass, chosen by what it touched. See spec/toolchain.md, "verify runs
what a change reaches"."""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from graph import ROOT, app_of, build_inputs, changed, dependents, node_graph, owner, rust_graph  # noqa: E402

# Whole-tree and cheap, so they run whatever changed.
ALWAYS = ["secrets", "refs", "comments", "shape", "rules", "check-scopes", "layers"]
# Whole-program by nature: tsc reads three programs, vitest one suite, oxlint the tree.
NODE = ["check", "lint", "test"]
# Gates that belong to one package, run when it or anything it imports changed.
PACKAGE_GATES = {
	"@canmi/site": [
		"check-site",
		"check-css",
		"check-css-budget",
		"check-css-extraction",
		"check-css-enumeration",
		"check-css-ramp",
	],
	"@canmi/cms": ["check-cms"],
	"@monoflake/panel": ["check-panel"],
	"@canmi/prose": ["check-prose"],
	"@canmi/social": ["check-social"],
	"@canmi/fonts": ["check-fonts"],
	"@monoflake/status-schema": ["check-status-schema"],
	"@canmi/status": ["check-status"],
}
RUST = ["lint-rust", "test-rust"]
EVERYTHING = ALWAYS + NODE + [g for gates in PACKAGE_GATES.values() for g in gates] + RUST

NODE_SUFFIXES = {".ts", ".js", ".mjs", ".cjs", ".svelte", ".css", ".json", ".html", ".yaml", ".yml"}
# The gates themselves: a change to how anything is checked is checked against everything.
GATE_FILES = ("mise.toml", ".mise/tasks/")
NODE_ROOT_FILES = {"package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "vitest.config.ts"}
RUST_ROOT_FILES = {"Cargo.toml", "Cargo.lock"}
# Read by the site's build and the corpus tests rather than imported, so no graph reaches them.
SITE_INPUTS = ("contents/", "data/")
# Rust files whose only check is a TypeScript test: the generated halves of the address maps.
NODE_CHECKED_RUST = {"lib/crates/canmi/src/lib.rs", "platform/libs/sdk/src/lib.rs"}
# Every app's declaration is read by the deploy crate's tests and by the gateway's scope table,
# whichever app it sits in.
DECLARATION = "service.toml"
DECLARATION_READERS = {"deploy"}
DECLARATION_PACKAGES = {"@canmi/gateway"}


def plan(files):
	"""The gates to run, and the Rust packages to run them over (None meaning all)."""
	if any(f == GATE_FILES[0] or f.startswith(GATE_FILES[1]) for f in files):
		return EVERYTHING, None, "the gates themselves changed"

	crate_dirs, crate_edges, included = rust_graph()
	built = build_inputs(crate_dirs)
	package_dirs, package_edges = node_graph()
	crates, packages, gates = set(), set(), list(ALWAYS)
	all_crates = all_packages = site_inputs = False

	for f in files:
		suffix = Path(f).suffix
		if f in RUST_ROOT_FILES or f == "rust-toolchain.toml":
			all_crates = True
		crates |= included.get(f, set())
		crates |= built.get(owner(f, built) or f, set())
		if app_of(f) and Path(f).name == DECLARATION:
			crates |= DECLARATION_READERS
			packages |= DECLARATION_PACKAGES
		crate = crate_dirs.get(owner(f, crate_dirs) or "")
		if crate and (suffix == ".rs" or f.endswith("/Cargo.toml")):
			crates.add(crate)

		if f in NODE_ROOT_FILES or f.startswith("tsconfig"):
			all_packages = True
		if f.startswith(SITE_INPUTS):
			site_inputs = True
		package = package_dirs.get(owner(f, package_dirs) or "")
		if package and (suffix in NODE_SUFFIXES or f in NODE_CHECKED_RUST):
			packages.add(package)

	reached_packages = set(package_dirs.values()) if all_packages else dependents(packages, package_edges)
	if reached_packages or site_inputs:
		gates += NODE
		if site_inputs:
			reached_packages.add("@canmi/site")
		for package, owned in PACKAGE_GATES.items():
			if package in reached_packages:
				gates += owned

	reached_crates = None if all_crates else dependents(crates, crate_edges)
	if all_crates or reached_crates:
		gates += RUST
	return gates, reached_crates, None


def main():
	arguments = sys.argv[1:]
	dry = "--dry-run" in arguments or "-n" in arguments
	since = arguments[arguments.index("--since") + 1] if "--since" in arguments else None
	# `--files a b` asks what a change to exactly those files would run, without making it.
	given = arguments[arguments.index("--files") + 1 :] if "--files" in arguments else None

	if "--all" in arguments or os.environ.get("AUDIT"):
		gates, crates, reason = EVERYTHING, None, "asked for everything"
	else:
		files = given if given is not None else changed(since)
		gates, crates, reason = plan(files)
		where = "given" if given is not None else f"since {since}" if since else "in the working copy"
		print(f"verify: {len(files)} file(s) {where}")
	if reason:
		print(f"verify: every gate, because {reason}")
	scope = "every crate" if crates is None else ", ".join(sorted(crates)) or "none"
	if "lint-rust" in gates:
		print(f"verify: Rust over {scope}")
	print(f"verify: {' '.join(gates)}")
	if dry:
		return 0

	environment = dict(os.environ)
	if crates is not None:
		environment["RUST_PACKAGES"] = " ".join(f"-p {crate}" for crate in sorted(crates))
	# Every gate reports, not only the first to fail: a red run is worth its whole list.
	command = ["mise", "run", "--continue-on-error", gates[0]]
	for gate in gates[1:]:
		command += [":::", gate]
	return subprocess.run(command, cwd=ROOT, env=environment).returncode


if __name__ == "__main__":
	sys.exit(main())
