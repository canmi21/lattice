{
	// The node programs under an app's `scripts/`. A third program because a file belongs to the
	// one whose globals it runs against, and these fell through the gap between the other two.
	// See spec/architecture/workspace.md, "A runtime's globals decide which program checks a file".
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// The browser's globals as well as node's, which is not the contradiction it looks like:
		// the conflict the other split avoids is DOM against `@cloudflare/workers-types`, and
		// nothing here carries those. These scripts do type-import browser modules.
		"lib": ["es2023", "dom"],
		"types": ["node"],
		// pnpm installs @types/node under the member that asked for it, not at this root.
		"typeRoots": ["apps/site/node_modules/@types", "node_modules/@types"]
	},
	"include": ["apps/*/scripts/**/*.ts"],
	"exclude": ["**/node_modules", "**/dist", "**/build"]
}
